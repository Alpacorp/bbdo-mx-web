# Envío del formulario de contacto (/api/contact).
# Sin RESEND_API_KEY o CONTACT_FROM el endpoint devuelve error y la página le
# dice al visitante que escriba directamente. Nunca finge haber enviado.

# Clave de Resend. En producción va en Vercel > Settings > Environment Variables.
RESEND_API_KEY=

# Remitente. En pruebas sirve el compartido de Resend; en producción tiene que
# ser una dirección de un dominio verificado, p. ej. web@bbdomexico.com
CONTACT_FROM=onboarding@resend.dev

# SOLO PRUEBAS. onboarding@resend.dev solo entrega al correo con el que está
# registrada la cuenta de Resend: cualquier otro destinatario devuelve 403.
# Mientras no haya dominio verificado, pon aquí ese correo y todos los mensajes
# irán ahí, con el buzón real al que iban en el asunto.
# DEBE QUEDAR VACÍA EN PRODUCCIÓN.
CONTACT_TO_OVERRIDE=
