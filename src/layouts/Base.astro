---
import '../styles/tokens.css';

/**
 * Base.astro — layout raíz: head, meta, canonical, JSON-LD.
 *
 * NOTA sobre <ClientRouter />: el brief (seccion 7) advierte que en Astro 6+
 * las view transitions cambian el timing de eventos. NO se monta todavia
 * porque el <script> de VideoHeadline corre al cargar el modulo, no en
 * 'astro:page-load' -> con ClientRouter el titular no se re-animaria al
 * navegar client-side. Cuando se decida activarlo hay que adaptar el
 * componente primero.
 */

interface Props {
  title: string;
  description?: string;
  /** Ruta canonica relativa, p.ej. '/work/'. Por defecto la actual. */
  path?: string;
  ogImage?: string;
  /** true solo en el home: evita el 'BBDO Mexico - BBDO Mexico' del sitio viejo. */
  isHome?: boolean;
}

const SITE_NAME = 'BBDO México';
const SITE_URL = 'https://bbdomexico.com';

// Ojo: el sitio actual tiene el typo "Omincon" sitewide (seccion 2). Es Omnicom.
const DEFAULT_DESCRIPTION =
  'BBDO México es una de las agencias de publicidad más premiadas del país y forma parte de BBDO Worldwide, red creativa de Omnicom Group.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  path,
  ogImage = '/v/modelo.png',
  isHome = false,
} = Astro.props;

const pageTitle = isHome ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonical = new URL(path ?? Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;

/**
 * JSON-LD — de jsonld-bbdo-mexico.html (seccion 8).
 *
 * PENDIENTE verificar con marketing/legal ANTES de publicar:
 *   [ ] razon social exacta vs. nombre comercial "BBDO México"
 *   [ ] foundingDate real (no inventar: el campo va omitido a proposito)
 *   [ ] ¿Camilo Plazas sigue como CEO tras la integracion Omnicom-IPG?
 *   [ ] correo de new business (hoy solo existe quierotrabajaren@)
 *   [ ] numberOfEmployees aproximado (opcional)
 * Validar en https://validator.schema.org/
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AdvertisingAgency',
      '@id': `${SITE_URL}/#organization`,
      name: SITE_NAME,
      alternateName: 'BBDO MX',
      url: `${SITE_URL}/`,
      description: DEFAULT_DESCRIPTION,
      slogan: 'Do Big Things',
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE_URL}/#logo`,
        url: `${SITE_URL}/wp-content/uploads/2024/01/logo-bbdo-red.png`,
        width: 800,
        height: 286,
        caption: SITE_NAME,
      },
      image: { '@id': `${SITE_URL}/#logo` },
      parentOrganization: {
        '@type': 'Organization',
        '@id': 'https://bbdo.com/#organization',
        name: 'BBDO Worldwide',
        url: 'https://bbdo.com/',
        parentOrganization: {
          '@type': 'Organization',
          name: 'Omnicom Group',
          url: 'https://www.omnicomgroup.com/',
          tickerSymbol: 'NYSE:OMC',
        },
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Calle Palo Santo 22, Piso 1, Lomas Altas',
        addressLocality: 'Miguel Hidalgo',
        addressRegion: 'Ciudad de México',
        postalCode: '11950',
        addressCountry: 'MX',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 19.3968252,
        longitude: -99.2276834,
      },
      telephone: '+52-55-5267-1500',
      areaServed: { '@type': 'Country', name: 'México' },
      knowsLanguage: ['es-MX', 'en'],
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'human resources',
          email: 'quierotrabajaren@bbdomexico.com',
          telephone: '+52-55-5267-1500',
          areaServed: 'MX',
          availableLanguage: ['Spanish', 'English'],
        },
      ],
      sameAs: [
        'https://www.linkedin.com/company/bbdomx/',
        'https://www.instagram.com/bbdomx/',
        'https://www.facebook.com/bbdomx',
        'https://twitter.com/BBDOmx',
      ],
      employee: { '@id': `${SITE_URL}/#camilo-plazas` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#camilo-plazas`,
      name: 'Camilo Plazas',
      jobTitle: 'Chief Executive Officer',
      worksFor: { '@id': `${SITE_URL}/#organization` },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      inLanguage: 'es-MX',
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Marca que el JS corre, ANTES del primer paint: los estados iniciales
         de animacion cuelgan de html.js, asi que sin JS todo se ve completo y
         no hay flash. Este si va is:inline (no importa nada); el <script> de
         VideoHeadline NO puede llevarlo, rompe el import de GSAP. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <slot />

    <footer class="pie">
      <div class="pie__inner">
        <p class="pie__marca">BBDO México</p>

        <nav aria-label="Legal">
          <ul class="pie__legal">
            <li><a href="/legal/privacidad/">Aviso de privacidad</a></li>
            <li><a href="/legal/terminos/">Términos de uso</a></li>
            <li><a href="/legal/cookies/">Aviso de cookies</a></li>
            <li><a href="/legal/alerta-de-estafa/">Alerta de estafa</a></li>
          </ul>
        </nav>

        <p class="pie__contacto">
          <a href="mailto:quierotrabajaren@bbdomexico.com">quierotrabajaren@bbdomexico.com</a>
        </p>

        <p class="pie__red">
          Parte de BBDO Worldwide, red creativa de Omnicom Group.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    min-height: 100svh;
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-ui);
    -webkit-font-smoothing: antialiased;
  }

  img,
  video {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
  }

  /* --- Pie --------------------------------------------------------------
     El global tiene un pie minimo (solo privacy notice + copyright). Aqui va
     mas: las cuatro paginas legales del sitio actual, incluida la alerta de
     estafa, que es especifica de MX y hoy existe en produccion. */
  .pie {
    position: relative;
    z-index: 1;
    background: var(--color-dark);
    color: var(--color-on-dark);
    font-size: 0.9rem;
  }
  .pie__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-xl);
    display: grid;
    gap: var(--space-m);
  }
  .pie__marca {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    text-transform: uppercase;
  }
  .pie__legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
  }
  .pie__legal a { text-decoration: none; border-bottom: 1px solid rgba(250,250,250,.35); }
  .pie__legal a:hover { border-bottom-color: currentColor; }
  .pie__contacto { margin: 0; }
  .pie__red { margin: 0; color: rgba(250, 250, 250, 0.6); }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
