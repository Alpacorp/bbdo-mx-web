---
import { SITE_NAME, SITE_URL, HR_EMAIL, organizationGraph } from '../organization';
import '../styles/tokens.css';
import '../styles/sections.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import CurtainTransition from '../components/CurtainTransition.astro';
import Wordmark from '../components/Wordmark.astro';
import { LEGAL_LINKS } from '../navigation';

/**
 * Base.astro — root layout: head, meta, canonical, JSON-LD.
 *
 * <ClientRouter /> is mounted. It used not to be, and the note here explained
 * why: every component's <script> did its work at module scope, so with
 * client-side routing the headline would animate once and never again. All
 * seven of them now hang off `astro:page-load` through src/lifecycle.ts, which
 * is what made this safe to turn on.
 *
 * It respects prefers-reduced-motion on its own: with that setting the swap
 * still happens, without the animation.
 */

interface Props {
  title: string;
  description?: string;
  /** Relative canonical path, e.g. '/the-work/'. Defaults to the current one. */
  path?: string;
  ogImage?: string;
  /** true only on the home page: avoids the old site's 'BBDO Mexico - BBDO Mexico'. */
  isHome?: boolean;
  /**
   * true on pages that open with the video banner: the header goes transparent
   * with a white logo. Everywhere else it is solid with a red logo.
   */
  overMedia?: boolean;
}

// Note: the current site has the "Omincon" typo site-wide (section 2). It is Omnicom.
/**
 * The share card, and nobody overrides it: every page on this site presents
 * this one image to a social scraper.
 *
 * It used to be `/v/modelo.png` — a 600x400 placeholder gradient with nothing
 * in it, named after a client whose footage it did not contain. Two problems
 * at once: an empty image as the agency's entire social presence, and 600x400
 * against the 1200x630 the platforms crop to.
 *
 * JPEG and not WebP on purpose. The posters on this page are WebP because
 * browsers all read it; scrapers are a wider and older population, and a share
 * card that one of them cannot decode is a blank preview rather than a
 * slightly larger file.
 */
const DEFAULT_OG_IMAGE = '/v/og-default.jpg';

const DEFAULT_DESCRIPTION =
  'BBDO México es una de las agencias de publicidad más premiadas del país y forma parte de BBDO Worldwide, red creativa de Omnicom Group.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  path,
  ogImage = DEFAULT_OG_IMAGE,
  isHome = false,
  overMedia = false,
} = Astro.props;

const pageTitle = isHome ? SITE_NAME : `${title} — ${SITE_NAME}`;
const canonical = new URL(path ?? Astro.url.pathname, SITE_URL).href;

/**
 * robots.txt closes crawling on the previews, but a crawler arriving by a
 * direct link does not consult it before indexing the page it already has.
 * The meta travels with the page.
 */
const noIndex =
  import.meta.env.VERCEL_ENV !== undefined && import.meta.env.VERCEL_ENV !== 'production';
const ogImageUrl = new URL(ogImage, SITE_URL).href;

/**
 * JSON-LD — de jsonld-bbdo-mexico.html (seccion 8).
 *
 * PENDING verification with marketing/legal BEFORE publishing:
 *   [ ] exact legal name vs. the trading name "BBDO México"
 *   [ ] real foundingDate (do not invent one: the field is omitted on purpose)
 *   [ ] is Camilo Plazas still CEO after the Omnicom-IPG merger?
 *   [ ] a new business email address (today only quierotrabajaren@ exists)
 *   [ ] approximate numberOfEmployees (optional)
 * The graph itself, and what is deliberately not in it, is in
 * src/organization.ts. Validate at https://validator.schema.org/
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': organizationGraph(),
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Icon order matters: Google's favicon crawler only ever asks for the
        .ico, current browsers prefer the SVG, the rest are home screens.
        All of them come out of `node scripts/build-icons.mjs`. */
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="generator" content={Astro.generator} />

    <!-- Marca que el JS corre, ANTES del primer paint: los estados iniciales
         de animacion cuelgan de html.js, asi que sin JS todo se ve completo y
         no hay flash. Este si va is:inline (no importa nada); el <script> de
         VideoHeadline NO puede llevarlo, rompe el import de GSAP.

         Y HAY QUE VOLVER A PONERLA EN CADA NAVEGACION. ClientRouter copia los
         atributos de <html> del documento entrante, y ese documento sale del
         servidor sin clase ninguna, asi que el intercambio se lleva 'js' por
         delante. Sin ella el header cae a su version sin JavaScript: la
         hamburguesa desaparece y el menu se despliega como lista. -->
    <script is:inline>
      (function () {
        function flagJs() {
          document.documentElement.classList.add('js');
        }
        flagJs();
        document.addEventListener('astro:after-swap', flagJs);

        /* Announce the new page. Only after a swap, never on the first load:
           there the browser has already said the title out loud and repeating
           it is noise. The delay lets the live region be re-read — a region
           that is replaced wholesale in the same tick is often skipped.

           The flag is a closure variable and NOT an attribute on <html>. That
           was the first version, and it would never have announced anything:
           ClientRouter replaces the <html> attributes with the incoming
           document's on every swap, so the flag would have been wiped each time
           and this would have taken the first-load branch forever. Same trap
           that dropped the `js` class. */
        let first = true;
        document.addEventListener('astro:page-load', function () {
          if (first) {
            first = false;
            return;
          }
          const region = document.querySelector('[data-route-announcer]');
          if (!region) return;
          region.textContent = '';
          setTimeout(function () {
            region.textContent = document.title;
          }, 120);
        });
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <ClientRouter />

    <!-- Each page can add its own tags to the head: /the-work/[slug] puts its
         CreativeWork JSON-LD here, IN ADDITION to the organisation block. -->
    <slot name="head" />
  </head>

  <body>
    {
      /* First thing in the tab order, and the only way past the header without
         going through it. It matters most on /people/, where the alternative
         is tabbing through 117 portraits to reach anything. Off-screen until
         focused, which is the one pattern screen-reader users expect. */
    }
    <a class="skip" href="#content">Saltar al contenido</a>

    {
      /* Client-side navigation is silent. The browser announces a new page on a
         real load; a swap changes the DOM under a screen reader without saying
         anything, and Astro's own route announcer is not in the output — this
         was measured, not assumed. So the page title is written here after each
         navigation and read out. */
    }
    <p class="announce" aria-live="polite" aria-atomic="true" data-route-announcer></p>
    <CurtainTransition />
    <Header overMedia={overMedia} current={Astro.url.pathname} />

    <slot />

    <footer class="footer">
      <div class="footer__inner">
        <p class="footer__brand">BBDO México</p>

        <nav aria-label="Legal">
          <ul class="footer__legal">
            {
              LEGAL_LINKS.map((e) => (
                <li>
                  {e.built ? (
                    <a href={e.href}>{e.label}</a>
                  ) : (
                    <span class="footer__pending">{e.label}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <p class="footer__contact">
          <a href={`mailto:${HR_EMAIL}`}>{HR_EMAIL}</a>
        </p>

        <p class="footer__network">Parte de BBDO Worldwide, red creativa de Omnicom Group.</p>
      </div>

      {
        /* The closing mark. The page used to end on four blocks of text and
           then stop; this gives it a last beat that is the brand itself, at the
           only size the page can give it. Cropped by the bottom edge on
           purpose — a mark that runs off the page reads as bigger than the
           page, which is the whole point of putting it here.

           Decorative: "BBDO México" is written in text directly above it. */
      }
      <div class="footer__mark">
        <Wordmark />
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    /* This has to be here too, not only on body: overflow is measured against
       documentElement, so with body clipping and html visible there was still
       horizontal scroll. */
    overflow-x: clip;
  }

  body {
    margin: 0;
    min-height: 100svh;

    /* The animations' initial states push elements sideways (translateX), and
       that created horizontal scroll before they entered. clip and not hidden:
       hidden would turn body into a scroll container and break the
       position:sticky elements inside it — the home banner among them. clip
       crops without creating that context. */
    overflow-x: clip;
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-ui);
    -webkit-font-smoothing: antialiased;
  }

  img,
  video {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
  }

  .skip {
    position: absolute;
    left: var(--space-s);
    top: var(--space-s);
    z-index: 101; /* over the curtain, which is 100 */
    padding: 0.7em 1.2em;
    background: var(--color-dark);
    color: var(--color-on-dark);
    font-family: var(--font-display);
    font-size: 1rem;
    text-decoration: none;
    border-radius: 999px;
    /* Moved out of sight rather than hidden: display:none and visibility:hidden
       both take it out of the tab order, which is the one thing it exists for. */
    transform: translateY(-200%);
    transition: transform var(--dur-fast) var(--ease);
  }
  .skip:focus {
    transform: translateY(0);
  }

  /* Announced, never seen. Not display:none and not visibility:hidden: both
     take the element out of the accessibility tree, and then there is nothing
     left to announce. */
  .announce {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* --- Pie --------------------------------------------------------------
     El global tiene un footer minimo (solo privacy notice + copyright). Aqui va
     more: las cuatro paginas legales del sitio current, incluida la alerta de
     estafa, que es especifica de MX y hoy existe en produccion. */
  .footer {
    position: relative;
    z-index: 1;
    background: var(--color-dark);
    color: var(--color-on-dark);
    font-size: 0.9rem;
  }
  .footer__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-xl);
    display: grid;
    gap: var(--space-m);
  }
  .footer__brand {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    text-transform: uppercase;
  }
  .footer__legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
  }
  /* WCAG 2.2 asks 24x24 of any target that is not inline in a sentence, and a
     row of legal links is not a sentence. These were 17px tall. The padding is
     on the top only so the underline stays where it was, tight under the text. */
  .footer__legal a {
    display: inline-block;
    padding-top: 7px;
    text-decoration: none;
    border-bottom: 1px solid rgba(250, 250, 250, 0.35);
  }
  .footer__legal a:hover {
    border-bottom-color: currentColor;
  }
  .footer__contact {
    margin: 0;
  }
  /* Same 24px floor as the legal row above. */
  .footer__contact a {
    display: inline-block;
    padding-top: 7px;
  }
  /* The container is shorter than the mark it holds, which is what does the
     cropping: 573x96 against the mark's own 573x164 leaves a little under
     three fifths of the letterforms showing. clip and not hidden, for the same
     reason as everywhere else on this site. */
  .footer__mark {
    margin-top: var(--space-2xl);
    aspect-ratio: 573 / 96;
    /* min-height: 0 is what makes the crop happen, and it is not redundant.
       A box with an aspect-ratio and an auto height takes a content-based
       automatic minimum, so the full-height mark inside floors the container
       at its own 408px and the ratio is quietly ignored — measured: 408 with
       this line removed, 239 with it. `overflow: clip` does not lift the floor
       on its own. */
    min-height: 0;
    overflow: clip;
    line-height: 0;
  }
  .footer__mark svg {
    display: block;
    width: 100%;
    height: auto;
    /* Barely above the ground it sits on. It is a closing note, not a second
       logo competing with the one in the header. */
    color: rgb(250 250 250 / 9%);
  }

  .footer__network {
    margin: 0;
    color: rgba(250, 250, 250, 0.6);
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
