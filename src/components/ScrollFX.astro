---
/**
 * ScrollFX.astro — the scroll motion layer.
 *
 * Renders nothing. Mounted once per page, it animates anything carrying a
 * `data-fx` attribute, so the markup stays declarative and there is no
 * per-view script.
 *
 * WHY NOT GSAP
 *   The previous version used GSAP + ScrollTrigger: 43.5 KB gzipped for a few
 *   reveals. This does the same with IntersectionObserver (~1 KB) and CSS
 *   transitions, and the parallax with `animation-timeline: view()`, which is
 *   native scroll with no JS at all. GSAP now only stays where it does
 *   something CSS cannot: the home page headline.
 *
 * VOCABULARY
 *   data-fx="up"            fades in from below
 *   data-fx="left"|"right"  enters from one side (the global site's gesture)
 *   data-fx="scale"         eases out of a zoom, giving a sense of material
 *   data-fx="lines"         reveals its children line by line, behind a mask
 *   data-fx="parallax"      moves slower than the scroll
 *   data-fx-stagger         staggers the direct children
 *   data-fx-delay="200"     delay in milliseconds
 *
 * NON-NEGOTIABLE RULES
 *   1. The default state is VISIBLE. Hidden states hang off html.js, so if the
 *      bundle never runs nothing is left invisible.
 *   2. prefers-reduced-motion turns everything off.
 *   3. Parallax is disabled on narrow screens: on mobile it is nauseating.
 */
---

<style is:global>
  /* --- Initial states, ONLY when JS is available -------------------------- */
  html.js [data-fx]:not([data-fx='parallax']),
  html.js [data-fx-stagger] > * {
    opacity: 0;
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
    transition-delay: var(--fx-delay, 0ms);
  }

  html.js [data-fx='up'] {
    transform: translateY(2.5rem);
  }
  html.js [data-fx='left'] {
    transform: translateX(-3rem);
  }
  html.js [data-fx='right'] {
    transform: translateX(3rem);
  }
  html.js [data-fx='scale'] {
    transform: scale(1.06);
  }
  html.js [data-fx-stagger] > * {
    transform: translateY(1.5rem);
  }

  /* Line reveal: each child rises behind its own mask. */
  [data-fx='lines'] > * {
    display: block;
    /* clip-path and not overflow:hidden: overflow changes the baseline of
       inline-blocks and crops ink that overshoots the line box. */
    clip-path: inset(-0.35em 0 -0.2em 0);
  }
  html.js [data-fx='lines'] > * {
    opacity: 0;
    transform: translateY(105%);
    transition:
      opacity 1s var(--ease),
      transform 1s var(--ease);
    transition-delay: calc(var(--i, 0) * 90ms);
  }

  /* --- Reveal -------------------------------------------------------------- */
  html.js [data-fx].fx-visible,
  html.js [data-fx-stagger].fx-visible > *,
  html.js [data-fx='lines'].fx-visible > * {
    opacity: 1;
    transform: none;
  }
  html.js [data-fx-stagger].fx-visible > * {
    transition-delay: calc(var(--i, 0) * 80ms);
  }

  /* --- Parallax: native scroll, zero JS ------------------------------------ */
  @media (min-width: 48rem) {
    @supports (animation-timeline: view()) {
      [data-fx='parallax'] {
        animation: fxParallax linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      @keyframes fxParallax {
        from {
          transform: translateY(-8%);
        }
        to {
          transform: translateY(8%);
        }
      }
    }
  }

  /* --- No animation: everything visible ------------------------------------ */
  /* Three routes to the same place: reduced-motion, the failsafe, and the
     normal state once revealed. */
  @media (prefers-reduced-motion: reduce) {
    html.js [data-fx],
    html.js [data-fx-stagger] > *,
    html.js [data-fx='lines'] > * {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      animation: none !important;
    }
  }

  html.fx-fallback [data-fx],
  html.fx-fallback [data-fx-stagger] > *,
  html.fx-fallback [data-fx='lines'] > * {
    opacity: 1 !important;
    transform: none !important;
  }
</style>

<script is:inline>
  /**
   * Failsafe, and inline on purpose: if the bundle never runs — network error,
   * CSP, a throw in another module — the initial states stay applied and the
   * content never appears. A script inside the module itself would be no help:
   * it would not run either.
   */
  setTimeout(function () {
    const h = document.documentElement;
    if (!h.classList.contains('fx-ready')) h.classList.add('fx-fallback');
  }, 3000);
</script>

<script>
  document.documentElement.classList.add('fx-ready'); // disarms the inline failsafe

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    // Index per child, so CSS can stagger without a timer per element.
    document
      .querySelectorAll<HTMLElement>('[data-fx-stagger], [data-fx="lines"]')
      .forEach((container) => {
        [...container.children].forEach((hijo, i) => {
          (hijo as HTMLElement).style.setProperty('--i', String(i));
        });
      });

    document.querySelectorAll<HTMLElement>('[data-fx-delay]').forEach((el) => {
      el.style.setProperty('--fx-delay', `${el.dataset.fxDelay}ms`);
    });

    const seen = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('fx-visible');
          seen.unobserve(e.target); // once seen, it never hides again
        });
      },
      // Fires slightly before the element reaches the bottom edge, so the
      // motion accompanies the scroll instead of trailing behind it.
      { rootMargin: '0px 0px -12% 0px', threshold: 0 }
    );

    document
      .querySelectorAll('[data-fx]:not([data-fx="parallax"]), [data-fx-stagger]')
      .forEach((el) => seen.observe(el));
  }
</script>
