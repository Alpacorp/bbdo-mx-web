---
import { NAVIGATION } from '../navigation';

/**
 * Header.astro — logo, menu button and the menu itself.
 *
 * Mirrors the global site's mechanics: logo on the left, button on the right
 * (54x42, 16px from the edge) and the menu as a full-screen overlay in Outfit
 * uppercase. On desktop too: the global site never lays the navigation out in
 * the bar, it always sits behind the button.
 *
 * WITHOUT JAVASCRIPT
 *   The menu is NOT an overlay until html.js exists. Without JS it renders as
 *   a plain list inside the header, which works. The button only shows up when
 *   it can actually do something. Same rule as the rest of the site: whatever
 *   does not need JS, does not depend on JS.
 *
 * CONTRAST
 *   `overMedia` is for pages that open with the video banner: there the header
 *   is transparent and the logo white. On pages that start on a light
 *   background it is solid and the logo red, the original asset's colour.
 */
interface Props {
  /** true on pages that open with the video banner. */
  overMedia?: boolean;
  /** Current path, used to mark the active entry. */
  current?: string;
}

const { overMedia = false, current = '' } = Astro.props;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class:list={['nav', overMedia && 'nav--over-media']}>
  <a class="nav__logo" href="/" aria-label="BBDO México — inicio">
    <img src="/v/logo-bbdo.png" alt="BBDO" width="100" height="26" />
  </a>

  <button class="nav__button" type="button" aria-expanded="false" aria-controls="menu-principal">
    <span class="nav__button-text">Menú</span>
    <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
  </button>

  <nav class="nav__menu" id="menu-principal" aria-label="Principal">
    <ul class="nav__list">
      {
        NAVIGATION.map((e) => (
          <li>
            {e.built ? (
              <a href={e.href} aria-current={isCurrent(e.href) ? 'page' : undefined}>
                {e.label}
              </a>
            ) : (
              /* Deliberately not a link: the page does not exist yet, and a
                 404 in the main menu is worse than a visibly pending entry. */
              <span class="nav__pending">
                {e.label}
                <small>pendiente</small>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10; /* above the sticky banner (0) and the content (1) */
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-m);
    padding: 24px 40px;
  }

  /* Over the banner the header floats. Elsewhere it needs its own background
     so the logo and button do not sit on top of content while scrolling. */
  .nav:not(.nav--over-media) {
    position: sticky;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  .nav__logo {
    display: block;
    line-height: 0;
    text-decoration: none;
  }
  .nav__logo img {
    width: 100px;
    height: 26px;
    object-fit: contain;
  }
  /* The only logo asset is red. Over the banner it is turned white:
     brightness(0) takes it to black keeping the alpha, invert(1) lightens it. */
  .nav--over-media .nav__logo img {
    filter: brightness(0) invert(1);
  }

  /* --- Button ------------------------------------------------------------- */
  /* Without JS it does nothing, so it is not shown. */
  .nav__button {
    display: none;
  }
  :global(html.js) .nav__button {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: auto;
    min-height: 42px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }
  .nav__button-text {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nav--over-media .nav__button {
    color: var(--color-on-dark);
  }

  .nav__bars {
    display: grid;
    gap: 6px;
    width: 26px;
  }
  .nav__bars i {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease);
  }
  /* Open: the two bars cross into an X. */
  .nav.is-open .nav__bars i:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .nav.is-open .nav__bars i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* --- Menu --------------------------------------------------------------- */
  /* By default (no JS) it is a plain list, usable as is. */
  .nav__menu {
    flex: 1;
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-s) var(--space-m);
  }

  /* With JS it becomes an overlay. */
  :global(html.js) .nav__menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: grid;
    place-items: center;
    background: var(--color-red);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-base) var(--ease),
      visibility var(--dur-base);
  }
  :global(html.js) .nav.is-open .nav__menu {
    opacity: 1;
    visibility: visible;
  }
  :global(html.js) .nav__list {
    flex-direction: column;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-xs);
    padding-inline: var(--gutter);
  }

  .nav__list a,
  .nav__pending {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    text-decoration: none;
  }
  :global(html.js) .nav__list a,
  :global(html.js) .nav__pending {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2rem, 7vw, 3.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-on-dark);
  }

  .nav__list a:hover {
    color: var(--color-accent);
  }
  :global(html.js) .nav__list a:hover {
    color: var(--color-ink);
  }
  .nav__list a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  /* Pending: visible and readable, but promises no destination that does not exist. */
  .nav__pending {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    opacity: 0.45;
    cursor: not-allowed;
  }
  .nav__pending small {
    font-family: var(--font-ui);
    font-weight: 400;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  :global(html.js) .nav__pending small {
    font-size: 0.75rem;
  }

  @media (max-width: 40rem) {
    .nav {
      padding: 18px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__bars i,
    :global(html.js) .nav__menu {
      transition: none;
    }
  }
</style>

<script>
  import { onPage } from '../lifecycle';

  /* Per page, and with a teardown: the overlay's own listeners die with the
     elements, but the Escape handler sits on document and would otherwise
     stack up one copy per navigation. */
  onPage(() => {
    const nav = document.querySelector<HTMLElement>('.nav');
    const button = nav?.querySelector<HTMLButtonElement>('.nav__button');
    const menu = nav?.querySelector<HTMLElement>('.nav__menu');
    if (!nav || !button || !menu) return;

    const links = () => [...menu.querySelectorAll<HTMLAnchorElement>('a')];

    /* Everything the overlay covers. `inert` takes it out of the tab order AND
       out of the accessibility tree, which the Tab trap below cannot do: a
       screen reader's virtual cursor ignores focus traps and would happily read
       a page nobody can see. */
    const detras = () => [...document.querySelectorAll<HTMLElement>('main, footer')];

    function toggle(si: boolean) {
      nav!.classList.toggle('is-open', si);
      button!.setAttribute('aria-expanded', String(si));
      // Lock background scrolling while the overlay covers the page.
      document.documentElement.style.overflow = si ? 'hidden' : '';
      detras().forEach((el) => (si ? el.setAttribute('inert', '') : el.removeAttribute('inert')));

      if (si) {
        /* The menu transitions out of visibility:hidden, and focus() on a
           hidden element is a silent no-op — which is exactly what used to
           happen: the menu opened and focus stayed outside it, so a keyboard
           user opened a menu they then had to tab all the way back into.

           TWO frames, and that number is measured, not guessed. Focusing in the
           same tick fails, and so does one requestAnimationFrame: visibility
           only commits on the frame after the class lands. Two works. If the
           transition on .nav__menu ever changes, re-measure this. */
        requestAnimationFrame(() => requestAnimationFrame(() => links()[0]?.focus()));
      } else {
        button!.focus();
      }
    }

    button.addEventListener('click', () => toggle(button.getAttribute('aria-expanded') !== 'true'));

    const onEscape = (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      if (button.getAttribute('aria-expanded') === 'true') toggle(false);
    };
    document.addEventListener('keydown', onEscape);

    // Navigating from inside the overlay closes it: otherwise an anchor link
    // would leave the menu open on top of the destination.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) toggle(false);
    });

    /**
     * Focus must not escape the overlay while it is open: if it does, the
     * keyboard navigates a page nobody can see.
     */
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = links();
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      } else if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      }
    });

    return () => {
      document.removeEventListener('keydown', onEscape);
      // The overlay locks scrolling on documentElement, which survives a swap:
      // navigating from inside an open menu would leave the next page unable
      // to scroll. The inert flags do not survive — those elements are the ones
      // being replaced — but clearing them costs nothing and keeps the two
      // sides of this symmetric.
      document.documentElement.style.overflow = '';
      detras().forEach((el) => el.removeAttribute('inert'));
    };
  });
</script>
