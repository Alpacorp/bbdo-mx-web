---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/** El tipo sale del propio esquema: si cambia la colección, cambia aquí. */
type Bloque = CollectionEntry<'work'>['data']['bloques'][number];

/**
 * BloqueCaso.astro — un bloque del cuerpo de un caso.
 *
 * Tipos: imagenes (1, 2 o 3), cita, datos, texto y video. El orden y la mezcla
 * los decide el contenido, no la plantilla: es lo que da ritmo y evita que la
 * página sea un muro de texto.
 *
 * El lado de entrada lo pasa la página padre y va alternando, como en el
 * global, donde cada tira entra por un costado distinto.
 */
interface Props {
  bloque: Bloque;
  /** Lado por el que entra. La página alterna izq/der. */
  lado: 'izq' | 'der';
}
const { bloque, lado } = Astro.props;
---

{
  bloque.tipo === 'imagenes' && (
    <figure
      class:list={[
        'bloque',
        'bloque--imagenes',
        bloque.sangre && 'bloque--sangre',
        `es-${bloque.imagenes.length}`,
      ]}
      data-fx={lado}
    >
      <div class="tira">
        {bloque.imagenes.map((img, i) => (
          <div class="tira__marco">
            <Image
              src={img}
              alt={bloque.alt?.[i] ?? ''}
              widths={[480, 960, 1600]}
              sizes="(max-width: 48rem) 100vw, (max-width: 72rem) 50vw, 33vw"
              loading="lazy"
              data-fx="parallax"
            />
          </div>
        ))}
      </div>
      {bloque.pie && <figcaption>{bloque.pie}</figcaption>}
    </figure>
  )
}

{
  bloque.tipo === 'cita' && (
    <blockquote class="bloque bloque--cita" data-fx="subir">
      <p class="cita__texto">{bloque.texto}</p>
      {bloque.autor && (
        <footer class="cita__pie">
          <span class="cita__autor">{bloque.autor}</span>
          {bloque.cargo && <span class="cita__cargo">{bloque.cargo}</span>}
        </footer>
      )}
    </blockquote>
  )
}

{
  bloque.tipo === 'datos' && (
    <ul class="bloque bloque--datos" data-fx-stagger>
      {bloque.datos.map((d) => (
        <li>
          <span class="dato__cifra">{d.cifra}</span>
          <span class="dato__nota">{d.nota}</span>
        </li>
      ))}
    </ul>
  )
}

{
  bloque.tipo === 'texto' && (
    <div class="bloque bloque--texto" data-fx="subir">
      {bloque.titulo && <h2>{bloque.titulo}</h2>}
      <p>{bloque.cuerpo}</p>
    </div>
  )
}

{
  bloque.tipo === 'video' && (
    <figure class="bloque bloque--video bloque--sangre" data-fx="escala">
      <video
        src={bloque.src}
        poster={bloque.poster.src}
        muted
        loop
        playsinline
        preload="none"
        aria-label={bloque.alt}
      />
    </figure>
  )
}

<style>
  .bloque {
    margin-block: var(--space-2xl);
  }

  /* A sangre: se sale del contenedor hasta los bordes de la pantalla. Es lo
     que da escala a las imágenes de campaña. */
  .bloque--sangre {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  /* --- Tiras de imágenes ------------------------------------------------ */
  .bloque--imagenes {
    padding: 0;
  }
  .tira {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px; /* el mismo gap del global */
    padding-inline: 24px;
  }
  .tira__marco {
    overflow: hidden; /* recorta el sobrante del parallax */
    border-radius: 4px;
    background: var(--color-dark);
  }
  .tira__marco img {
    width: 100%;
    height: 116%;
    margin-top: -8%;
    object-fit: cover;
    display: block;
  }
  /* Sin parallax no hace falta sobrante, y así no se recorta el encuadre. */
  @media (max-width: 48rem), (prefers-reduced-motion: reduce) {
    .tira__marco img {
      height: 100%;
      margin-top: 0;
    }
  }

  .bloque--imagenes figcaption {
    padding-inline: 24px;
    margin-top: var(--space-s);
    color: var(--color-dim);
    font-size: 0.9rem;
  }

  /* Proporciones del global: cuantas más imágenes, más cuadradas. */
  .es-1 .tira__marco {
    aspect-ratio: 16 / 9;
  }
  .es-2 .tira__marco {
    aspect-ratio: 3 / 2;
  }
  .es-3 .tira__marco {
    aspect-ratio: 7 / 6;
  }

  @media (min-width: 48rem) {
    .es-2 .tira {
      grid-template-columns: repeat(2, 1fr);
    }
    .es-3 .tira {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- Cita -------------------------------------------------------------- */
  .bloque--cita {
    margin-inline: 0;
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-m);
  }
  .cita__texto {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.6rem, 4.5vw, 3.2rem);
    line-height: 1.08;
    margin: 0;
    /* El ancho va AQUÍ y no en el blockquote: `ch` se resuelve con la fuente
       del propio elemento, y en el padre son 1rem de la fuente de texto, no
       los 3.2rem de la display. Puesto arriba salía una palabra por línea. */
    max-width: 22ch;
  }
  .cita__pie {
    margin-top: var(--space-m);
    display: grid;
    gap: 2px;
    font-size: 0.95rem;
  }
  .cita__cargo {
    color: var(--color-dim);
  }

  /* --- Datos ------------------------------------------------------------- */
  .bloque--datos {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--space-l) var(--space-m);
    border-block: 1px solid var(--color-line);
    padding-block: var(--space-l);
  }
  .bloque--datos li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .dato__cifra {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
    color: var(--color-accent);
  }
  .dato__nota {
    color: var(--color-dim);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  /* --- Texto ------------------------------------------------------------- */
  .bloque--texto {
    max-width: var(--measure);
  }
  .bloque--texto h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 var(--space-s);
  }
  .bloque--texto p {
    margin: 0;
    line-height: 1.6;
    font-size: 1.05rem;
  }

  /* --- Video ------------------------------------------------------------- */
  .bloque--video video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    background: var(--color-dark);
  }
</style>
