---
/**
 * VimeoPlayer.astro — the campaign's film, where it belongs.
 *
 * WHY THE IFRAME IS NOT EMBEDDED DIRECTLY
 *   A Vimeo iframe drags in close to a megabyte of third-party JavaScript and
 *   starts talking to their servers before anyone has pressed play. On a case
 *   page that is weight and tracking for the 90% of visitors who never watch.
 *
 *   So a facade is painted first: the key visual — which is already the frame
 *   Vimeo uses as its thumbnail — and a button. The iframe is built on click,
 *   with autoplay, and by then it is exactly what the person asked for. The
 *   page still weighs what it weighed.
 *
 * WITHOUT JAVASCRIPT
 *   The button does not exist and a link to the film on Vimeo takes its place.
 *   What is lost is the embedded playback, not access to the film.
 *
 * dnt=1 asks Vimeo not to track. That is not optional on a page that links to
 * its own privacy notice.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Vimeo's numeric id, exactly as it sits in the case's front matter. */
  id: string;
  poster: ImageMetadata;
  posterAlt: string;
  /** Used in the iframe's title and in the button's label. */
  title: string;
}

const { id, poster, posterAlt, title } = Astro.props;
---

<figure class="player" data-vimeo={id} data-vimeo-title={title}>
  <Image
    class="player__poster"
    src={poster}
    alt={posterAlt}
    widths={[600, 1200, 1800]}
    sizes="(max-width: 60rem) 100vw, 1200px"
    loading="eager"
  />

  <button class="player__play" type="button">
    <span class="player__icon" aria-hidden="true"></span>
    <span class="player__text">Ver el video<span class="sr-only"> de {title}</span></span>
  </button>

  <noscript>
    <a class="player__link" href={`https://vimeo.com/${id}`} rel="noopener">
      Ver el video en Vimeo
    </a>
  </noscript>
</figure>

<style>
  .player {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-dark);
  }
  .player :global(img),
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .player :global(img) {
    object-fit: cover;
  }

  /* The button covers the whole poster: on a film's title card the target is
     the card, not a 48px circle in the middle of it. */
  .player__play {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    border: 0;
    background: rgb(22 22 22 / 25%);
    color: #fafafa;
    cursor: pointer;
    transition: background var(--dur-base) var(--ease);
  }
  .player__play:hover,
  .player__play:focus-visible {
    background: rgb(22 22 22 / 45%);
  }
  .player__play:focus-visible {
    outline: 3px solid var(--color-red);
    outline-offset: -3px;
  }

  /* A triangle made out of borders: no icon font and no SVG to load. */
  .player__icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 14px 0 14px 24px;
    border-color: transparent transparent transparent #fafafa;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 40%));
  }
  .player__play:hover .player__icon {
    border-left-color: var(--color-red);
  }

  .player__text {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.9rem;
    text-shadow: 0 1px 4px rgb(0 0 0 / 50%);
  }

  .player__link {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-s);
    text-align: center;
    background: var(--color-dark);
    color: #fafafa;
  }

  /* .sr-only is a global utility in styles/sections.css now: it was scoped
     here, so any other component writing class="sr-only" rendered it plainly
     visible. The legal pages' loading status did exactly that. */

  @media (prefers-reduced-motion: reduce) {
    .player__play {
      transition: none;
    }
  }
</style>

<script>
  import { onPage } from '../lifecycle';

  /**
   * The iframe is built on click, never before. It replaces the whole facade so
   * the poster is not left holding memory behind the player.
   *
   * Per page and with no teardown: every listener here is on an element inside
   * the swapped body, so it goes when the element goes.
   */
  onPage(() => {
    document.querySelectorAll<HTMLElement>('[data-vimeo]').forEach((figure) => {
      const button = figure.querySelector('button');
      if (!button) return;

      button.addEventListener('click', () => {
        const id = figure.dataset.vimeo;
        const title = figure.dataset.vimeoTitle ?? 'Video de la campaña';

        const iframe = document.createElement('iframe');
        /* dnt=1: sin seguimiento. autoplay: lo acaban de pedir. */
        iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`;
        iframe.title = title;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.setAttribute('allowfullscreen', '');

        figure.replaceChildren(iframe);
        iframe.focus();
      });
    });
  });
</script>
