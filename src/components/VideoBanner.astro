---
/**
 * VideoBanner.astro — full-bleed video banner, the home page's first section.
 *
 * Replicates section.video-banner-section from the global site. Measured on
 * 2026-08-18.
 *
 * COMPOSITION
 *   - The section is fixed and the content scrolls over it. Here that is done
 *     with sticky: same effect, without taking it out of flow or needing a
 *     spacer.
 *   - The video covers everything, object-fit: cover.
 *   - Two small words (Outfit 600 at 42px) in RED, anchored to the bottom
 *     corners: 40px from the side, 19px from the bottom. The video sits in
 *     between: on the global site it reads "DO [video] THINGS", with the video
 *     standing in for BIG.
 *
 * THE ANIMATION
 *   On top of the video there is an SVG with viewBox 0 0 1440 750 and
 *   preserveAspectRatio="none" (it stretches to any size). Inside:
 *     - a <mask> holding a white rect (opaque) and four black shapes (holes)
 *     - a full-screen RED rect painted through that mask
 *   In other words: a red curtain with four windows onto the video. The four
 *   windows enter from the four sides. Once settled, the red survives only as
 *   16px gutters that frame the video into four panels.
 *
 *   The four paths are the global site's, verbatim. Approximating them with
 *   rounded rects was tried and does not hold up: the real geometry carries
 *   detail a rect cannot express.
 *     - The top-centre one is a CIRCLE (centre 720,105, radius 89), not a
 *       rounded square.
 *     - The side panels carry a horizontal slot carved at y=194-202, plus
 *       brand-system marks: two pills on the left, a bracket on the right.
 *       Being holes that are missing, the red shows through and those marks
 *       end up drawn in red.
 *     - Gutter between panels: 7.14. The 16 is only the outer margin.
 *     - Corner radius: 11.93.
 *
 *   Animated with CSS and not GSAP, on purpose: a CSS animation runs even if
 *   the JS fails, and the default state — no animation, and with
 *   reduced-motion — is windows OPEN. The video is never covered because a
 *   script did not run.
 *
 * DELIBERATE DIFFERENCE
 *   The global site's video uses autoplay, preload="auto" and no poster
 *   (video-pesado.mp4, 1465x755). Here the poster is mandatory and is the LCP;
 *   the video is only requested after the load event. Section 6 of the brief.
 */

import { CURTAIN_WIDE, CURTAIN_TALL } from '../curtain';

interface Props {
  /** Word anchored bottom-left. On the global site: "DO". */
  left: string;
  /** Word anchored bottom-right. On the global site: "THINGS". */
  right: string;
  src: string;
  poster: string;
  /**
   * View-transition name for the poster, so a card on the index morphs into
   * this banner instead of the two cross-fading. The <video> is what carries
   * it: its snapshot IS the poster, which is the same file the card shows.
   */
  transitionName?: string;
  /**
   * The logo is NOT rendered here any more: Header.astro owns it, because it
   * is needed on every page and not only on the ones with a banner.
   */
}

const { left, right, src, poster, transitionName } = Astro.props;

// Unique, deterministic id per banner: if a page has two, their masks do not
// collide, and it does not change between builds.
const uid = `mask-${poster.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '')}`;
const uidTall = `${uid}-movil`;
---

<section class="banner" data-video-banner>
  <video
    class="banner__video"
    src={src}
    poster={poster}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    transition:name={transitionName}></video>

  <svg
    class="banner__curtain banner__curtain--wide"
    viewBox={CURTAIN_WIDE.viewBox}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <mask id={uid}>
        <rect width="1440" height="750" fill="white"></rect>
        <path class="window window--left" d={CURTAIN_WIDE.window.left} fill="black"></path>
        <g class="circle-layer"
          ><path class="window window--top" d={CURTAIN_WIDE.window.top} fill="black"></path></g
        >
        <path class="window window--bottom" d={CURTAIN_WIDE.window.bottom} fill="black"></path>
        <path class="window window--right" d={CURTAIN_WIDE.window.right} fill="black"></path>
      </mask>
    </defs>
    <rect
      width="1440"
      height="750"
      fill="var(--color-red)"
      mask={`url(#${uid})`}
      shape-rendering="crispEdges"></rect>
  </svg>

  <svg
    class="banner__curtain banner__curtain--tall"
    viewBox={CURTAIN_TALL.viewBox}
    preserveAspectRatio="xMidYMin slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <mask id={uidTall}>
        <rect width="359" height="526" fill="white"></rect>
        <path class="window window--left" d={CURTAIN_TALL.window.left} fill="black"></path>
        <path class="window window--top" d={CURTAIN_TALL.window.top} fill="black"></path>
        <path class="window window--bottom" d={CURTAIN_TALL.window.bottom} fill="black"></path>
        <path class="window window--right" d={CURTAIN_TALL.window.right} fill="black"></path>
      </mask>
    </defs>
    <rect
      width="359"
      height="526"
      fill="var(--color-red)"
      mask={`url(#${uidTall})`}
      shape-rendering="crispEdges"></rect>
  </svg>

  <p class="banner__txt banner__txt--izq">{left}</p>
  <p class="banner__txt banner__txt--der">{right}</p>
</section>

<style>
  .banner {
    /* sticky and not fixed: same "content scrolls over it" effect, without
       taking the section out of flow or needing a spacer. It only works if
       whatever follows rides in its own stacking context above this one, on an
       opaque background — see .case__shell on the case page. A plain block
       after this section paints UNDERNEATH it, because this one is positioned
       and that one is not. */
    position: sticky;
    top: 0;
    z-index: 0;

    height: 100svh;
    overflow: hidden;
    background: var(--color-dark);
  }

  .banner__video,
  .banner__curtain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .banner__video {
    object-fit: cover;
    display: block;
  }

  /* Mobile-first, like the global site: the tall mask is the default and the
     wide one takes over from 1024px. Their ratios differ (359x526 vs
     1440x750); it is not the same mask stretched: in portrait the panels reach
     the edge, with no outer margin.

     The tall mask uses preserveAspectRatio="xMidYMin slice" and not "none":
     a 390x844 phone has a ratio of 0.46 against the viewBox's 0.68, so
     stretching turned the circle into an ellipse. The circle is a brand
     element and cannot be deformed. With slice it crops at the sides — where
     the panels already reach the edge and there is no frame to lose — and the
     circle stays round.

     YMin and not YMid: centred, on a portrait tablet (768x1024) the crop was
     split top and bottom and sliced the top off the circle. Anchored to the
     top, the whole crop goes to the foot, where the panels are long
     rectangles and losing a few pixels goes unnoticed.

     The wide mask uses "none", like the global site, and NOT slice. slice was
     tried so the circle would not flatten on 4:3 screens, and the cure was
     worse: cropping vertically loses the 16-unit bottom margin, that is, the
     red border at the foot. On a 1908x930 screen (ratio 2.05 against the
     viewBox's 1.92) the crop is about 64px and the panels run off the
     los paneles se salen por el footer.

     A frame closed on all four sides is part of the design, so it wins over
     the circle deforming. Known trade-off: at ratios far from 1.92 — a
     landscape tablet at 1.33 — the circle looks oval. The global site behaves
     exactly the same. Fixing both at once means lifting the circle into its
     own layer with its ratio preserved, which is handled below.

     The tall mask does keep slice with YMin: there the panels reach the edge
     and there is no outer frame to lose, so cropping costs nothing. */
  .banner__curtain--tall {
    display: block;
  }
  .banner__curtain--wide {
    display: none;
  }

  /* The swap goes by ORIENTATION, not width alone. With the min-width rule
     on its own, a landscape phone (844x390) kept the tall mask: cropping to
     cover ate the circle and the composition was reduced to two red stripes.
     The global site's 1024px threshold is kept as well, for narrow but
     landscape desktop windows. */
  @media (min-width: 64rem), (orientation: landscape) {
    .banner__curtain--tall {
      display: none;
    }
    .banner__curtain--wide {
      display: block;
    }
  }

  /* --- La curtain ------------------------------------------------------- */
  /* Default state: windows OPEN. If there is no animation — reduced motion,
     an old browser, whatever — what shows is the framed video, never a red
     screen. The animation only adds the entrance travel. */
  .window {
    transform-box: view-box;
    transform-origin: 0 0;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .window--left {
      animation: enterLeft 1.15s var(--ease) 0.15s both;
    }
    .window--right {
      animation: enterRight 1.15s var(--ease) 0.15s both;
    }
    .window--top {
      animation: enterTop 1.05s var(--ease) 0.32s both;
    }
    .window--bottom {
      animation: enterBottom 1.05s var(--ease) 0.24s both;
    }
  }

  /* The circle's own layer. Kept separate from the <path> on purpose: the path
     carries the entrance animation and this <g> carries the stretch
     compensation, so they do not fight. Without JS it stays at scale(1) and the
     circle looks like the global site's, slightly oval at ratios far from 1.92:
     acceptable degradation, not breakage. */
  .circle-layer {
    transform-box: view-box;
    transform-origin: 720px 105.278px; /* the circle's own centre */
  }

  /* Offsets are in viewBox units, not screen px, so each mask needs its own:
     the tall viewBox is 359x526 and the wide one 1440x750. The wide values are
     the ones GSAP leaves in place on the global site (-800/+800 on x,
     -200/+800 on y); the tall ones are scaled so each panel clears its side
     completely. */
  .banner__curtain--tall .window--left {
    animation-name: enterLeftTall;
  }
  .banner__curtain--tall .window--right {
    animation-name: enterRightTall;
  }
  .banner__curtain--tall .window--top {
    animation-name: enterTopTall;
  }
  .banner__curtain--tall .window--bottom {
    animation-name: enterBottomTall;
  }

  @keyframes enterLeft {
    from {
      transform: translate(-800px, 0);
    }
  }
  @keyframes enterRight {
    from {
      transform: translate(800px, 0);
    }
  }
  @keyframes enterTop {
    from {
      transform: translate(0, -200px);
    }
  }
  @keyframes enterBottom {
    from {
      transform: translate(0, 800px);
    }
  }

  @keyframes enterLeftTall {
    from {
      transform: translate(-260px, 0);
    }
  }
  @keyframes enterRightTall {
    from {
      transform: translate(260px, 0);
    }
  }
  @keyframes enterTopTall {
    from {
      transform: translate(0, -120px);
    }
  }
  @keyframes enterBottomTall {
    from {
      transform: translate(0, 560px);
    }
  }

  /* --- The two words ----------------------------------------------------- */
  .banner__txt {
    position: absolute;
    bottom: 19px;
    margin: 0;
    z-index: 1;

    font-family: var(--font-display);
    font-weight: var(--weight-display);
    /* 42px is the global site's measure at 1512px wide. The floor of 1.5rem
       keeps it readable on mobile. */
    font-size: clamp(1.5rem, 2.8vw, 42px);
    line-height: 1.26;
    text-transform: uppercase;
    color: var(--color-red);
  }
  .banner__txt--izq {
    left: 40px;
  }
  .banner__txt--der {
    right: 40px;
  }

  @media (max-width: 40rem) {
    .banner__txt {
      bottom: 14px;
    }
    .banner__txt--izq {
      left: 20px;
    }
    .banner__txt--der {
      right: 20px;
    }
  }
</style>

<script>
  import { onPage } from '../lifecycle';

  /**
   * Is this connection worth pulling the clip over?
   *
   * The banner's film is placeholder material weighing 30.8 MB, twelve times
   * the budget section 6 of the brief sets, and that same section names
   * Mexican 4G specifically. Until the real file arrives, anyone browsing on
   * data saver or on a slow connection keeps the poster — which is what shows
   * for the first second regardless: the poster is the LCP and the video only
   * replaces it afterwards.
   *
   * The API does not exist in Safari, and there the decision is not made for
   * the user: with no information, it loads. This trims the known bad case; it
   * does not guess.
   */
  function connectionIsGoodEnough(): boolean {
    const c = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    if (!c) return true;
    if (c.saveData) return false;
    return c.effectiveType !== 'slow-2g' && c.effectiveType !== '2g' && c.effectiveType !== '3g';
  }

  /**
   * The poster is the LCP. The video is not requested until the page has
   * finished loading, and it pauses off-viewport to save battery and CPU.
   */
  function start(): IntersectionObserver | undefined {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const vid = e.target as HTMLVideoElement;
          if (e.isIntersecting) vid.play().catch(() => {});
          else vid.pause();
        });
      },
      { threshold: 0.1 }
    );

    let watching = false;
    document.querySelectorAll<HTMLElement>('[data-video-banner]').forEach((el) => {
      const v = el.querySelector('video');
      if (!v) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!connectionIsGoodEnough()) return;

      v.preload = 'auto';
      v.play().catch(() => {});
      io.observe(v);
      watching = true;
    });

    return watching ? io : undefined;
  }

  /**
   * Keeping the circle round at any ratio.
   *
   * The wide mask uses preserveAspectRatio="none" so the frame closes on all
   * four sides at any size. The price is that it stretches differently on x
   * and y, and a circle inside a stretched viewBox comes out oval. Since the
   * circle is a brand element, it is compensated: scaled inversely to the
   * stretch, around its own centre.
   *
   * It is also capped so it never invades the side panels: as the screen gets
   * closer to square the centre cell narrows and the circle at its original
   * size no longer fits, so it shrinks uniformly.
   *
   * If this script does not run, the <g> stays at scale(1) and the circle
   * looks like the global site's. It degrades, it does not break.
   */
  const VB_W = 1440,
    VB_H = 750;
  const CELL_WIDTH = 816.525 - 623.552; // gap between the left and right panels
  const DIAMETER = 178.684;

  function adjustCircle() {
    document.querySelectorAll<HTMLElement>('[data-video-banner]').forEach((el) => {
      const svg = el.querySelector<SVGSVGElement>('.banner__curtain--wide');
      const layer = svg?.querySelector<SVGGElement>('.circle-layer');
      if (!svg || !layer) return;

      const r = svg.getBoundingClientRect();
      if (!r.width || !r.height) return; // esta oculta: es la vertical la que manda

      const sx = r.width / VB_W;
      const sy = r.height / VB_H;

      // diameter it would have keeping its original vertical proportion,
      // capped so it fits inside the cell with a little air
      const wanted = DIAMETER * sy;
      const fits = CELL_WIDTH * sx * 0.93;
      const d = Math.min(wanted, fits);

      layer.style.transform = `scale(${d / sx / DIAMETER}, ${d / sy / DIAMETER})`;
    });
  }

  let pending = 0;
  function onResize() {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(adjustCircle);
  }

  /* These two stay at module scope on purpose: they are bound to the window,
     not to the banner, and adjustCircle re-queries the DOM every time, so a
     page with no banner is simply a no-op. Rebinding them per page would
     stack one pair of listeners per navigation. */
  window.addEventListener('resize', onResize);
  window.addEventListener('orientationchange', onResize);

  onPage(() => {
    adjustCircle();

    /* Still gated on `load`, which is the whole point of the poster being the
       LCP: the clip is not requested until the page has finished. After a
       client-side navigation the document is already complete, so this is the
       immediate branch and the video starts with the new banner. */
    let observer: IntersectionObserver | undefined;
    const begin = () => {
      observer = start();
    };
    if (document.readyState === 'complete') begin();
    else window.addEventListener('load', begin, { once: true });

    return () => {
      window.removeEventListener('load', begin);
      observer?.disconnect();
    };
  });
</script>
