---
/**
 * VideoHeadline.astro — el efecto firma: clips de campana incrustados en el
 * flujo del titular, sentados en la linea base y atados al `em`.
 *
 * El titular se renderiza como texto real; los slots son aria-hidden. Eso es
 * lo que permite tener el efecto Y el texto indexable a la vez.
 *
 * Calibrado contra bbdo.com el 2026-08-18: Outfit 600, line-height 1.02,
 * slots de 0.81em de alto con anchos variables, radius 0.117em y
 * vertical-align baseline. Ver docs/referencia-visual-bbdo-global.md.
 *
 * Dos desviaciones deliberadas respecto al global, ambas a favor nuestro:
 *   - Usamos <h1>; el global usa <h2> y su home no tiene ningun h1.
 *   - Los videos llevan poster y preload="none"; los del global van con
 *     autoplay y sin poster, lo que viola la seccion 6 del brief.
 *
 * Instalacion:  npm i gsap
 */

interface Clip {
  after: number; // indice de la palabra tras la cual se inserta el clip
  src: string;
  poster: string;
  label?: string;
  /** Ancho del slot. El global usa estos tres: 1.70em / 2.10em / 2.70em. */
  size?: 'sm' | 'md' | 'lg';
}

/** Un elemento ya colocado en el orden de render. */
type Elemento =
  | { type: 'salto' }
  | { type: 'word'; word: string; accent: boolean; i: number }
  | ({ type: 'clip' } & Clip);

/**
 * OJO con el nombre de las props: esta interfaz declaraba `as?: 'h1' | 'h2'` y
 * eso rompía la inferencia de Astro. Con una prop llamada `as` -palabra
 * reservada de TypeScript- `Astro.props` pasa a ser `Record<string, any>` y
 * TODO el componente se queda sin tipos, en silencio. Lo destapó `astro check`;
 * el build compila igual. Por eso la prop se llama `etiqueta`.
 */
interface Props {
  /**
   * Palabras del titular. El valor '|' fuerza un salto de línea, para poder
   * decidir dónde parte la frase en vez de dejarlo al ancho disponible:
   * ['Somos','BBDO','México','|','Do','Big','Things'] mantiene "Do Big Things"
   * junto en una línea. En pantallas estrechas el texto sigue partiendo por
   * donde haga falta; el salto solo añade uno, no impide los demás.
   */
  words: string[];
  clips?: Clip[];
  accentIndex?: number; // palabra en color de marca
  etiqueta?: 'h1' | 'h2';
}

const { words, clips = [], accentIndex = -1, etiqueta: Tag = 'h1' } = Astro.props;

// Los saltos no cuentan como palabra: si contaran, correrían los índices de
// `after` de los clips y `accentIndex`, y habría que recalcularlos a mano.
let indicePalabra = -1;
const sequence: Elemento[] = words.flatMap((word): Elemento[] => {
  if (word === '|') return [{ type: 'salto' }];
  indicePalabra += 1;
  const i = indicePalabra;
  return [
    { type: 'word', word, accent: i === accentIndex, i },
    ...clips.filter((c) => c.after === i).map((c): Elemento => ({ type: 'clip', ...c })),
  ];
});
---

<Tag class="vh" data-video-headline>
  {
    sequence.map((item) =>
      item.type === 'salto' ? (
        <br />
      ) : item.type === 'word' ? (
        <span class:list={['vh__w', item.accent && 'vh__w--accent']}>
          <i>{item.word}</i>
        </span>
      ) : (
        <span
          class:list={['vh__slot', `vh__slot--${item.size ?? 'md'}`]}
          aria-hidden="true"
          data-label={item.label}
        >
          <video
            src={item.src}
            poster={item.poster}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          />
        </span>
      )
    )
  }
</Tag>

<script is:inline>
  /**
   * Failsafe. El estado oculto del titular cuelga de html.js, asi que si el
   * bundle de GSAP no llega a ejecutarse -error de red, CSP, fallo del CDN,
   * un throw en otro modulo- el titular se queda invisible con el texto en
   * el DOM. Esto lo revela igualmente pasados 2.5s.
   *
   * Solo arma el contador cuando la pestana esta visible: en segundo plano
   * el navegador estrangula rAF y GSAP no arranca, y no queremos "revelar
   * sin animacion" una pestana que el usuario todavia no ha mirado.
   */
  (function () {
    function revelar() {
      document.querySelectorAll('[data-video-headline]').forEach(function (el) {
        if (!el.hasAttribute('data-vh-ready')) el.setAttribute('data-vh-fallback', '');
      });
    }
    function armar() {
      setTimeout(revelar, 2500);
    }
    if (document.visibilityState === 'visible') armar();
    else
      document.addEventListener('visibilitychange', function h() {
        if (document.visibilityState === 'visible') {
          document.removeEventListener('visibilitychange', h);
          armar();
        }
      });
  })();
</script>

<style>
  .vh {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--size-display);
    line-height: var(--lh-display);
    letter-spacing: normal;
    /* El global lleva text-transform:none y el texto fuente ya en mayusculas.
       Preferimos lo contrario: mismo resultado visual, pero el texto que lee
       un buscador o un lector de pantalla queda en capitalizacion normal. */
    text-transform: uppercase;
    max-width: 18ch;
    margin: 0;
  }

  /* El estado por defecto es TODO VISIBLE. Si el JS no corre -bloqueado, error
     de red, bundle caido- el titular se lee completo en vez de quedar atrapado
     tras un transform que nadie va a revertir. El estado oculto del que parte
     la animacion cuelga de html.js, clase que pone un script inline en
     Base.astro antes del primer paint (sin flash). */
  .vh__w {
    display: inline-block;

    /* Los <span> salen del map() sin nodos de texto entre ellos: sin este
       margen las palabras se pegan ("BIGTHINGS" en vez de "BIG THINGS"). */
    margin-right: 0.2em;

    /* Mascara del reveal. clip-path y no overflow:hidden por dos razones:
       overflow:hidden cambia la linea base del inline-block (rompe la
       alineacion con los slots) y recorta la tinta que sobresale de la caja
       de linea. Los insets negativos agrandan la mascara sin tocar la caja. */
    /* Arriba 0.36em: con line-height 1.02 el acento de la E de MEXICO sobresale
       de la caja de linea y se cortaba. Abajo 0.14em basta para la tinta de
       Outfit. Medido en pantalla, no calculado. */
    clip-path: inset(-0.36em 0 -0.14em 0);
  }
  .vh__w > i {
    display: inline-block;
    font-style: normal;
    transform: none;
  }
  :global(html.js) .vh__w > i {
    /* 125% (175px) supera los 160px que ocupa la mascara hacia abajo (1.02em
       de caja + 0.14em de inset): la palabra arranca fuera de ella. Si se
       cambia el inset inferior o el line-height, recalcular este valor. */
    transform: translateY(125%);
  }
  .vh__w--accent > i {
    color: var(--color-accent);
  }

  .vh__slot {
    display: inline-block;
    /* baseline, como el global: con overflow:hidden la linea base del
       inline-block es su borde inferior, asi que el slot se sienta sobre la
       linea base del texto. */
    vertical-align: baseline;
    position: relative;
    overflow: hidden;
    border-radius: 0.117em;
    background: var(--color-dark);

    /* Atado al em: escala con la tipografia sin media queries. */
    height: 0.81em;
    margin: 0 0.1em;

    transform: none;
    transform-origin: left center;
  }
  :global(html.js) .vh__slot {
    transform: scaleX(0);
  }

  /* Failsafe: mismo resultado que reduced-motion, sin animacion. Van despues
     de las reglas de html.js a proposito: empatan en especificidad y gana el
     orden de aparicion. */
  /* Lleva html.js delante a proposito. Sin el, `[data-vh-fallback] .vh__w > i`
     empata en clases con `html.js .vh__w > i` pero tiene un elemento menos, y
     pierde. Con html.js delante gana por especificidad y por orden. */
  :global(html.js) :global([data-vh-fallback]) .vh__w > i {
    transform: none;
  }
  :global(html.js) :global([data-vh-fallback]) .vh__slot {
    transform: scaleX(1);
  }

  /* Los tres anchos del global. */
  .vh__slot--sm {
    width: 1.7em;
  }
  .vh__slot--md {
    width: 2.1em;
  }
  .vh__slot--lg {
    width: 2.7em;
  }

  .vh__slot video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vh__slot::before {
    content: attr(data-label);
    position: absolute;
    left: 6px;
    bottom: 4px;
    z-index: 2;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.75);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Prefijadas con html.js a proposito: sin JS el estado por defecto ya es
       visible, y sin el prefijo estas reglas perderian por especificidad. */
    :global(html.js) .vh__w > i {
      transform: none;
    }
    :global(html.js) .vh__slot {
      transform: scaleX(1);
    }
    .vh__slot video {
      display: none;
    } /* poster estatico */
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.querySelectorAll<HTMLElement>('[data-video-headline]').forEach((el) => {
    el.setAttribute('data-vh-ready', ''); // desarma el failsafe inline
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce) {
      gsap.set(el.querySelectorAll('.vh__w > i'), { y: 0 });
      gsap.set(el.querySelectorAll('.vh__slot'), { scaleX: 1 });
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    tl.to(el.querySelectorAll('.vh__w > i'), {
      y: 0,
      duration: 1.1,
      stagger: 0.07,
    }).to(
      el.querySelectorAll('.vh__slot'),
      {
        scaleX: 1,
        duration: 0.9,
        stagger: 0.09,
        onStart() {
          // Los clips arrancan DESPUES del titular: el LCP nunca compite.
          el.querySelectorAll<HTMLVideoElement>('.vh__slot video').forEach((v) => {
            v.preload = 'auto';
            v.play().catch(() => {});
          });
        },
      },
      '-=0.6'
    );

    // Pausa fuera de viewport: bateria y CPU.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.1 }
    );
    el.querySelectorAll('.vh__slot video').forEach((v) => io.observe(v));
  });
</script>
