---
/**
 * VideoHeadline.astro — the signature effect: campaign clips embedded in the
 * headline's flow, sitting on the baseline and tied to the `em`.
 *
 * The headline renders as real text; the slots are aria-hidden. That is what
 * makes it possible to have the effect AND indexable text at the same time.
 *
 * Calibrated against bbdo.com on 2026-08-18: Outfit 600, line-height 1.02,
 * slots 0.81em tall with variable widths, radius 0.117em and vertical-align
 * baseline. See docs/referencia-visual-bbdo-global.md.
 *
 * Two deliberate departures from the global site, both in our favour:
 *   - We use <h1>; they use <h2> and their home page has no h1 at all.
 *   - Our videos carry a poster and preload="none"; theirs use autoplay with
 *     no poster, which breaks section 6 of the brief.

 */

interface Clip {
  after: number; // index of the word this clip is inserted after
  src: string;
  poster: string;
  label?: string;
  /** Slot width. The global site uses these three: 1.70em / 2.10em / 2.70em. */
  size?: 'sm' | 'md' | 'lg';
}

/** One item already placed in render order. */
type Item =
  | { type: 'break' }
  | { type: 'word'; word: string; accent: boolean; i: number }
  | ({ type: 'clip'; j: number } & Clip);

/**
 * CAREFUL with prop names: this interface used to declare `as?: 'h1' | 'h2'`
 * and that broke Astro's inference. With a prop named `as` — a TypeScript
 * reserved word — `Astro.props` becomes `Record<string, any>` and the WHOLE
 * component silently loses its types. `astro check` surfaced it; the build
 * compiles either way. That is why the prop is called `tag`.
 */
interface Props {
  /**
   * Headline words. The value '|' forces a line break, so the copy decides
   * where the phrase splits instead of leaving it to the available width:
   * ['Somos','BBDO','México','|','Do','Big','Things'] keeps "Do Big Things"
   * together on one line. On narrow screens the text still wraps wherever it
   * needs to; the break only adds one, it does not prevent the others.
   */
  words: string[];
  clips?: Clip[];
  accentIndex?: number; // word en color de marca
  tag?: 'h1' | 'h2';
}

const { words, clips = [], accentIndex = -1, tag: Tag = 'h1' } = Astro.props;

// Breaks do not count as words: if they did, the clips' `after` indices and
// `accentIndex` would shift and need recalculating by hand.
let wordIndex = -1;
let slotIndex = -1;
const sequence: Item[] = words.flatMap((word): Item[] => {
  if (word === '|') return [{ type: 'break' }];
  wordIndex += 1;
  const i = wordIndex;
  return [
    { type: 'word', word, accent: i === accentIndex, i },
    ...clips
      .filter((c) => c.after === i)
      .map((c): Item => ({ type: 'clip', j: (slotIndex += 1), ...c })),
  ];
});

/**
 * The timings the animation used to get from a GSAP timeline, worked out here
 * instead. GSAP's second tween started 0.6s before the first one ended, and
 * "the first one ends" depends on how many words there are — which is known at
 * build time and does not need a library to compute at runtime.
 *
 *   words:   1.1s each, 0.07s apart
 *   windows: 0.9s each, 0.09s apart, starting 0.6s before the words finish
 */
const WORD_DURATION = 1.1;
const WORD_STEP = 0.07;
const OVERLAP = 0.6;
const wordsEnd = WORD_DURATION + Math.max(0, wordIndex) * WORD_STEP;
const slotsStart = Math.max(0, wordsEnd - OVERLAP);
---

<Tag class="vh" data-video-headline style={`--vh-slots-start:${slotsStart}s`}>
  {
    sequence.map((item) =>
      item.type === 'break' ? (
        <br />
      ) : item.type === 'word' ? (
        <span class:list={['vh__w', item.accent && 'vh__w--accent']} style={`--i:${item.i}`}>
          <i>{item.word}</i>
        </span>
      ) : (
        <span
          class:list={['vh__slot', `vh__slot--${item.size ?? 'md'}`]}
          aria-hidden="true"
          data-label={item.label}
          style={`background-image:url(${item.poster});--j:${item.j}`}
        >
          <video
            src={item.src}
            poster={item.poster}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          />
        </span>
      )
    )
  }
</Tag>

<style>
  .vh {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--size-display);
    line-height: var(--lh-display);
    letter-spacing: normal;
    /* The global site uses text-transform:none with the source text already in
       caps. We do the opposite: same visual result, but the text a search
       engine or a screen reader reads stays in normal capitalisation. */
    text-transform: uppercase;
    max-width: 18ch;
    margin: 0;
  }

  /* The default state is EVERYTHING VISIBLE. If the JS does not run — blocked,
     network error, bundle down — the headline reads in full instead of being
     trapped behind a transform nobody will revert. The hidden state the
     animation starts from hangs off html.js, a class an inline script in
     Base.astro sets before first paint (no flash). */
  .vh__w {
    display: inline-block;

    /* The <span>s come out of map() with no text nodes between them: without
       this margin the words run together ("BIGTHINGS" instead of "BIG THINGS"). */
    margin-right: 0.2em;

    /* The reveal mask. clip-path and not overflow:hidden for two reasons:
       overflow:hidden changes the inline-block's baseline (breaking alignment
       with the slots) and crops ink that overshoots the line box. Negative
       insets grow the mask without touching the box. */
    /* 0.36em on top: with line-height 1.02 the accent on the E in MÉXICO
       overshoots the line box and was being clipped. 0.14em below is enough for
       Outfit's ink. Measured on screen, not calculated. */
    clip-path: inset(-0.36em 0 -0.14em 0);
  }
  .vh__w > i {
    display: inline-block;
    font-style: normal;
    transform: none;
  }
  /* The reveal, in CSS. It used to be a GSAP timeline, which cost 27 KB gzipped
     — 79% of all the JavaScript on this site — for two staggered tweens that
     the stylesheet can express on its own. GSAP's `expo.out` is
     cubic-bezier(0.16, 1, 0.3, 1), which is already --ease.

     --i is written into the markup at build time, so nothing has to walk the
     DOM to number these.

     Only under no-preference: with reduced motion there is no hidden state to
     begin with, which is simpler and safer than animating and then undoing it.
     125% (175px) clears the 160px the mask extends downward (1.02em of box +
     0.14em of inset): the word starts outside it. If the bottom inset or the
     line-height changes, recalculate this value. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .vh__w > i {
      animation: vhWord 1.1s var(--ease) calc(var(--i, 0) * 0.07s) both;
    }
    :global(html.js) .vh__slot {
      animation: vhSlot 0.9s var(--ease) calc(var(--vh-slots-start, 0.85s) + var(--j, 0) * 0.09s)
        both;
    }
  }

  @keyframes vhWord {
    from {
      transform: translateY(125%);
    }
  }
  @keyframes vhSlot {
    from {
      transform: scaleX(0);
    }
  }
  .vh__w--accent > i {
    color: var(--color-accent);
  }

  .vh__slot {
    display: inline-block;
    /* baseline, like the global site: with overflow:hidden an inline-block's
       baseline is its bottom edge, so the slot sits on the text baseline. */
    vertical-align: baseline;
    position: relative;
    overflow: hidden;
    border-radius: 0.117em;
    /* The poster is painted here as well as on the <video>, so the slot is
       never an empty dark box: not while the poster decodes, and not under
       reduced motion, where the clip is never requested at all. */
    background: var(--color-dark) center / cover no-repeat;

    /* Tied to the em: scales with the type without media queries. */
    height: 0.81em;
    margin: 0 0.1em;

    transform: none;
    transform-origin: left center;
  }

  /* Failsafe: same result as reduced-motion, without animation. Placed after
     the html.js rules on purpose: they tie on specificity and source order
     wins. */

  /* The global site's three widths. */
  .vh__slot--sm {
    width: 1.7em;
  }
  .vh__slot--md {
    width: 2.1em;
  }
  .vh__slot--lg {
    width: 2.7em;
  }

  .vh__slot video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vh__slot::before {
    content: attr(data-label);
    position: absolute;
    left: 6px;
    bottom: 4px;
    z-index: 2;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.75);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* The video used to be display:none here, with a comment claiming the
       poster took over. It does not: `poster` is an attribute OF the video, so
       hiding the element hides the poster with it and the slot fell back to
       its own --color-dark background. Anyone browsing with reduced motion —
       and that is how this very page was reviewed — saw the signature effect
       as three black rectangles inside the headline.

       Nothing needs hiding. The script returns early under reduced motion, so
       with preload="none" the element never fetches the clip and paints the
       poster and only the poster. The background-image on the slot is the
       belt: it shows even if the poster attribute has not decoded yet, so the
       slot is never a black hole. */
    .vh__slot video {
      pointer-events: none;
    }
  }
</style>

<script>
  import { onPage } from '../lifecycle';

  /**
   * All that is left of this component's JavaScript: starting the clips at the
   * right moment, and stopping them when they scroll away.
   *
   * The reveal itself is CSS now. It was a GSAP timeline, and GSAP was 27 KB
   * gzipped — 79% of every byte of script this site ships — to stagger two
   * groups of elements with an easing curve that was already in the tokens.
   *
   * WHY animationstart AND NOT A TIMER
   *   The clips must not begin before the headline does, or they compete with
   *   it for the first paint; that was the point of GSAP's onStart. Hanging off
   *   the first window's own animation keeps the two in step by construction,
   *   so changing a duration in the stylesheet cannot silently desynchronise a
   *   number over here.
   *
   * Under reduced motion nothing runs: no animation to hook, and nothing
   * autoplays, which is what it did before.
   */
  onPage(() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const observers: IntersectionObserver[] = [];

    document.querySelectorAll<HTMLElement>('[data-video-headline]').forEach((el) => {
      const videos = [...el.querySelectorAll<HTMLVideoElement>('.vh__slot video')];
      const firstSlot = el.querySelector<HTMLElement>('.vh__slot');
      if (!firstSlot || !videos.length) return;

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause(); // battery and CPU
          });
        },
        { threshold: 0.1 }
      );
      observers.push(io);

      firstSlot.addEventListener(
        'animationstart',
        () => {
          videos.forEach((v) => {
            v.preload = 'auto';
            v.play().catch(() => {});
            io.observe(v);
          });
        },
        { once: true }
      );
    });

    return () => observers.forEach((io) => io.disconnect());
  });
</script>
