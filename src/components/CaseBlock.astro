---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/** The type comes from the schema itself: change the collection, change this. */
type Block = CollectionEntry<'work'>['data']['blocks'][number];

/**
 * CaseBlock.astro — one block in a case study body.
 *
 * Types: images (1, 2 or 3), quote, stats, text and video. Order and mix are
 * decided by the content, not the template: that is what gives the page rhythm
 * and stops it being a wall of text.
 *
 * The entrance side is passed down by the parent page and alternates, like the
 * global site, where each strip enters from a different edge.
 */
interface Props {
  block: Block;
  /** Which side it enters from. The page alternates left/right. */
  side: 'left' | 'right';
}
const { block, side } = Astro.props;
---

{
  block.type === 'images' && (
    <figure
      class:list={[
        'block',
        'block--images',
        block.fullBleed && 'block--fullbleed',
        `es-${block.images.length}`,
      ]}
      data-fx={side}
    >
      <div class="strip">
        {block.images.map((img, i) => (
          <div class="strip__frame">
            <Image
              src={img}
              alt={block.alt?.[i] ?? ''}
              widths={[480, 960, 1600]}
              sizes="(max-width: 48rem) 100vw, (max-width: 72rem) 50vw, 33vw"
              loading="lazy"
              data-fx="parallax"
            />
          </div>
        ))}
      </div>
      {block.caption && <figcaption>{block.caption}</figcaption>}
    </figure>
  )
}

{
  block.type === 'quote' && (
    <blockquote class="block block--quote" data-fx="up">
      <p class="quote__text">{block.text}</p>
      {block.author && (
        <footer class="quote__footer">
          <span class="quote__author">{block.author}</span>
          {block.role && <span class="quote__role">{block.role}</span>}
        </footer>
      )}
    </blockquote>
  )
}

{
  block.type === 'stats' && (
    <ul class="block block--stats" data-fx-stagger>
      {block.stats.map((d) => (
        <li>
          <span class="stat__figure">{d.figure}</span>
          <span class="stat__note">{d.note}</span>
        </li>
      ))}
    </ul>
  )
}

{
  block.type === 'text' && (
    <div class="block block--text" data-fx="up">
      {block.title && <h2>{block.title}</h2>}
      <p>{block.body}</p>
    </div>
  )
}

{
  block.type === 'video' && (
    <figure class="block block--video block--fullbleed" data-fx="scale">
      <video
        src={block.src}
        poster={block.poster.src}
        muted
        loop
        playsinline
        preload="none"
        aria-label={block.alt}
      />
    </figure>
  )
}

<style>
  .block {
    margin-block: var(--space-2xl);
  }

  /* Full bleed: breaks out of the container to the screen edges. This is what
     gives the campaign images their scale. */
  .block--fullbleed {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  /* --- Image strips ------------------------------------------------------ */
  .block--images {
    padding: 0;
  }
  .strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px; /* same gap as the global site */
    padding-inline: 24px;
  }
  .strip__frame {
    overflow: hidden; /* crops the parallax overflow */
    border-radius: 4px;
    background: var(--color-dark);
  }
  .strip__frame img {
    width: 100%;
    height: 116%;
    margin-top: -8%;
    object-fit: cover;
    display: block;
  }
  /* Without parallax the overflow is not needed, and the framing stays intact. */
  @media (max-width: 48rem), (prefers-reduced-motion: reduce) {
    .strip__frame img {
      height: 100%;
      margin-top: 0;
    }
  }

  .block--images figcaption {
    padding-inline: 24px;
    margin-top: var(--space-s);
    color: var(--color-dim);
    font-size: 0.9rem;
  }

  /* Global site ratios: the more images in a strip, the squarer they get. */
  .es-1 .strip__frame {
    aspect-ratio: 16 / 9;
  }
  .es-2 .strip__frame {
    aspect-ratio: 3 / 2;
  }
  .es-3 .strip__frame {
    aspect-ratio: 7 / 6;
  }

  @media (min-width: 48rem) {
    .es-2 .strip {
      grid-template-columns: repeat(2, 1fr);
    }
    .es-3 .strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- Quote --------------------------------------------------------------- */
  .block--quote {
    margin-inline: 0;
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-m);
  }
  .quote__text {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.6rem, 4.5vw, 3.2rem);
    line-height: 1.08;
    margin: 0;
    /* The measure goes HERE and not on the blockquote: `ch` resolves against
       the element's own font, and on the parent that is 1rem of the body face,
       not the 3.2rem display. Set higher up it wrapped one word per line. */
    max-width: 22ch;
  }
  .quote__footer {
    margin-top: var(--space-m);
    display: grid;
    gap: 2px;
    font-size: 0.95rem;
  }
  .quote__role {
    color: var(--color-dim);
  }

  /* --- Stats --------------------------------------------------------------- */
  .block--stats {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--space-l) var(--space-m);
    border-block: 1px solid var(--color-line);
    padding-block: var(--space-l);
  }
  .block--stats li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat__figure {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
    color: var(--color-accent);
  }
  .stat__note {
    color: var(--color-dim);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  /* --- Text ---------------------------------------------------------------- */
  .block--text {
    max-width: var(--measure);
  }
  .block--text h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 var(--space-s);
  }
  .block--text p {
    margin: 0;
    line-height: 1.6;
    font-size: 1.05rem;
  }

  /* --- Video --------------------------------------------------------------- */
  .block--video video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    background: var(--color-dark);
  }
</style>
