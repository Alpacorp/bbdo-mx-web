---
/**
 * AnniversaryIntro.astro — the home page's opening during the 50th, 9-12 October.
 *
 * WHAT IT DOES, IN ORDER (about four seconds)
 *   1. The screen is the banner's red, closed. The BBDO wordmark draws itself
 *      as one line — the traced outline in src/wordmark.ts is a single closed
 *      ring, so it can be drawn in one stroke — then fills.
 *   2. The mark gives way to a "50" CUT OUT of the red. Through the numerals
 *      the banner's own key visual shows, slowly settling: the number is a
 *      window, like the four in the banner, not type printed on top.
 *   3. The red fades into the banner's red, which is the same red, and the
 *      banner's four windows enter as they always do — only later.
 *
 *   So the intro does not replace the brand's opening; it holds it closed for
 *   a moment and opens it with the number. Nothing here is decoration from
 *   outside the site: the red, the mark, the curtain and the knockout are all
 *   devices it already uses.
 *
 * WHEN IT PLAYS
 *   Only while <html> carries `anniv-intro`, which the inline script in
 *   Base.astro sets: from 9 to 12 October, on the home page, once per
 *   tab session, never with reduced motion. Without that class this renders
 *   `display: none` and costs one hidden element.
 *
 * IT GETS OUT OF THE WAY
 *   Any tap, key, wheel or touch ends it at once, and the banner's windows are
 *   pulled forward to open right then instead of waiting out the hold. Four
 *   seconds is long for anyone who came for something else.
 *
 * ACCESSIBILITY
 *   The whole overlay is aria-hidden: it is a picture of a number. What it
 *   says is said in text by the sr-only line, which stays readable for the
 *   whole celebration, not only while the animation runs.
 */
import { WORDMARK_PATH, WORDMARK_VIEWBOX } from '../wordmark';
import { ANNIVERSARY, ANNIVERSARY_YEARS } from '../anniversary';

interface Props {
  /** The banner's poster: what shows through the numerals. */
  poster: string;
}

const { poster } = Astro.props;
---

<p class="anniv-note sr-only">
  BBDO México cumple {ANNIVERSARY_YEARS} años: {ANNIVERSARY.founded}–{ANNIVERSARY.year}.
</p>

<div class="anniv" data-anniv-intro aria-hidden="true">
  <img class="anniv__poster" src={poster} alt="" decoding="async" />

  {
    /* "meet" so the number is whole at any ratio, and a red rect far larger
       than the viewBox so the curtain still covers what "meet" leaves around
       it. The mask region has to be widened to match: by default it stops at
       -10%/120% of the element's box and the overflow would be clipped. */
  }
  <svg
    class="anniv__curtain"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <defs>
      <mask
        id="anniv-knockout"
        maskUnits="userSpaceOnUse"
        x="-5000"
        y="-5000"
        width="11000"
        height="11000"
      >
        <rect x="-5000" y="-5000" width="11000" height="11000" fill="white"></rect>
        <text class="anniv__num" x="500" y="500" text-anchor="middle" fill="black"
          >{ANNIVERSARY_YEARS}</text
        >
      </mask>
    </defs>
    <rect
      x="-5000"
      y="-5000"
      width="11000"
      height="11000"
      fill="var(--color-red)"
      mask="url(#anniv-knockout)"></rect>
  </svg>

  <svg class="anniv__mark" viewBox={WORDMARK_VIEWBOX} focusable="false">
    {/* pathLength="1" so the dash arithmetic is the same at any size. */}
    <path d={WORDMARK_PATH} pathLength="1"></path>
  </svg>

  <p class="anniv__years">{ANNIVERSARY.founded} — {ANNIVERSARY.year}</p>
</div>

<style>
  /* The hold, in ONE place: how long the intro keeps the banner closed. The
     overlay leaves at this point and the banner's windows start at their own
     delays plus this. The script reads it back to pull them forward on skip. */
  :global(:root) {
    --anniv-hold: 3.5s;
  }

  /* The sentence exists for the celebration, like everything else here. Hidden with
     display, because .sr-only alone keeps it readable. */
  .anniv-note {
    display: none;
  }
  :global(html.anniversary) .anniv-note {
    display: block;
  }

  .anniv {
    display: none;
  }
  :global(html.anniv-intro) .anniv {
    display: block;
    position: fixed;
    inset: 0;
    /* Above the header (10), below CurtainTransition (100): a navigation
       started mid-intro still gets its wipe. */
    z-index: 90;
    overflow: hidden;
    background: var(--color-dark);
    animation: annivOut 0.6s ease-in var(--anniv-hold) forwards;
  }

  .anniv__poster,
  .anniv__curtain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .anniv__poster {
    object-fit: cover;
    animation: annivSettle 4s var(--ease) both;
  }

  /* Outfit 700 at 700 units: the two numerals come out about 85% of the
     viewBox wide, so in portrait they span the phone and in landscape they
     fill most of the height. The baseline is pushed down by a third of the
     cap height so the numerals, not the em box, are what sits centred. */
  .anniv__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 700px;
    transform: translateY(0.25em);
    transform-box: fill-box;
    transform-origin: center;
    animation:
      annivNumIn 0.8s var(--ease) 2s both,
      annivNumOut 0.9s ease-in calc(var(--anniv-hold) - 0.1s) forwards;
  }

  .anniv__mark {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(72vw, 34rem);
    translate: -50% -50%;
    overflow: visible;
    color: var(--color-on-dark);
    animation: annivMarkOut 0.4s ease-in 1.9s forwards;
  }
  .anniv__mark path {
    fill: currentColor;
    fill-opacity: 0;
    stroke: currentColor;
    /* In viewBox units, where the mark is 1 wide: about 2px at desktop size,
       1px on a phone. */
    stroke-width: 0.004;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      annivDraw 1.3s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards,
      annivFill 0.5s ease-out 1.2s forwards;
  }

  .anniv__years {
    position: absolute;
    left: 0;
    right: 0;
    /* Just under the numerals, whose cap height is about 0.49 of the shorter
       side of the screen (see .anniv__num). */
    top: calc(50% + min(100vw, 100svh) * 0.3);
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1rem, 2.2vw, 1.75rem);
    letter-spacing: 0.08em;
    color: var(--color-on-dark);
    animation: annivYears 0.6s var(--ease) 2.4s both;
  }

  /* Skipped: everything leaves now. Replacing the animation list drops the
     queued exit, so this is the only thing that runs. */
  :global(html.anniv-intro) .anniv.is-skipped {
    animation: annivOut 0.3s ease-out forwards;
  }

  /* Hold the banner closed while the intro plays: each window keeps its own
     stagger (VideoBanner.astro) plus the hold. This selector outranks the
     banner's scoped one, so order does not matter. */
  :global(html.anniv-intro [data-video-banner] .window--left),
  :global(html.anniv-intro [data-video-banner] .window--right) {
    animation-delay: calc(var(--anniv-hold) + 0.15s);
  }
  :global(html.anniv-intro [data-video-banner] .window--top) {
    animation-delay: calc(var(--anniv-hold) + 0.32s);
  }
  :global(html.anniv-intro [data-video-banner] .window--bottom) {
    animation-delay: calc(var(--anniv-hold) + 0.24s);
  }

  @keyframes annivDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes annivFill {
    to {
      fill-opacity: 1;
    }
  }
  @keyframes annivMarkOut {
    to {
      opacity: 0;
      transform: translateY(-1.5rem);
    }
  }
  @keyframes annivNumIn {
    from {
      fill-opacity: 0;
      transform: translateY(0.25em) scale(1.12);
    }
    to {
      fill-opacity: 1;
      transform: translateY(0.25em) scale(1);
    }
  }
  @keyframes annivNumOut {
    to {
      transform: translateY(0.25em) scale(1.35);
    }
  }
  @keyframes annivYears {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  @keyframes annivSettle {
    from {
      transform: scale(1.12);
    }
  }
  @keyframes annivOut {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

<script>
  import { onPage } from '../lifecycle';

  const SEEN_KEY = 'bbdo-50-intro';

  onPage(() => {
    const root = document.documentElement;
    const el = document.querySelector<HTMLElement>('[data-anniv-intro]');
    if (!el || !root.classList.contains('anniv-intro')) return;

    /* Marked at the start, not the end: a reload mid-intro is someone who has
       already seen it and wants the page. */
    try {
      sessionStorage.setItem(SEEN_KEY, 'seen');
    } catch {
      /* Blocked storage: it plays again next time. Harmless. */
    }

    const holdMs = parseFloat(getComputedStyle(root).getPropertyValue('--anniv-hold')) * 1000;

    const events = ['pointerdown', 'keydown', 'wheel', 'touchmove'] as const;
    const skip = () => {
      stop();
      el.classList.add('is-skipped');
      /* A CSS animation's currentTime counts its delay too. Moving it to the
         hold leaves each window exactly its own stagger to wait, as if the
         intro had never been there. */
      document.querySelectorAll('[data-video-banner] .window').forEach((w) => {
        w.getAnimations().forEach((a) => {
          const t = Number(a.currentTime ?? 0);
          if (t < holdMs) a.currentTime = holdMs;
        });
      });
    };
    const stop = () => events.forEach((e) => window.removeEventListener(e, skip));

    events.forEach((e) => window.addEventListener(e, skip, { passive: true }));
    /* When it has left on its own there is nothing left to skip. */
    el.addEventListener('animationend', (e) => {
      if (e.target === el) stop();
    });

    return stop;
  });
</script>
