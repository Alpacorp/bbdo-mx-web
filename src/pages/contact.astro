---
/**
 * /contact/ — the one page that asks the visitor for something.
 *
 * Section 4 of the brief wants routing by enquiry: nuevo negocio, talento y
 * prensa. Section 7 records that the global does it as a multi-step modal —
 * topic, then region, then office. Region and office do not apply here: there
 * is one office, and asking a visitor to pick it would be theatre.
 *
 * NO JAVASCRIPT REQUIRED, AND WHY THIS PAGE IS THE ONE THAT IS NOT STATIC
 *   The form posts natively to /api/contact, which answers with a redirect
 *   carrying the outcome in the query string. That is what renders the message
 *   below. The script only intercepts it to avoid the round trip and keep what
 *   the visitor typed.
 *
 *   That only works if the page is rendered per request. Prerendered, this
 *   read of searchParams happens once at build time against an empty query and
 *   the states never appear — which is exactly what it did until this comment
 *   was written: the page claimed to work without JavaScript and silently
 *   swallowed every outcome.
 *
 *   So this one page opts out of prerendering. Section 3 of the brief keeps
 *   the site static "salvo el formulario", and this is the formulario. The
 *   other 25 pages are untouched: it is one route, and it is the only route
 *   whose output depends on what the visitor just did.
 *
 * BEFORE THIS GOES LIVE — see the note by the consent checkbox. Collecting
 * personal data in Mexico requires an aviso de privacidad at the point of
 * collection, and that page does not exist yet.
 */
import Base from '../layouts/Base.astro';
import ScrollFX from '../components/ScrollFX.astro';
import { TOPICS } from '../contact-routing';
import { SITE_NAME, TELEPHONE, HR_EMAIL } from '../organization';

/* Rendered per request: see the note above. */
export const prerender = false;

/* Rendered server-side from the redirect, so the states exist without JS. */
/* The query-string keys stay in Spanish: they are the contract with
   /api/contact and they show up in a URL the visitor can see. Only the local
   names are English. */
const state = Astro.url.searchParams.get('estado');
const reason = Astro.url.searchParams.get('motivo');
---

<Base
  title="Contacto"
  path="/contact/"
  description={`Habla con ${SITE_NAME}: nuevo negocio, talento y prensa. Ciudad de México.`}
>
  <ScrollFX />

  <main id="content">
    <div class="section-shell section-shell--head">
      <h1 class="hero" data-fx="lines">
        <span>Hablemos</span>
      </h1>
      <p class="lede" data-fx="up" data-fx-delay="120">
        Dinos de qué se trata y llega a quien tiene que llegar.
      </p>
    </div>

    <section class="section-shell" aria-labelledby="form-title">
      <header class="section-head">
        <h2 id="form-title" data-fx="up">Escríbenos</h2>
      </header>

      {
        state === 'ok' && (
          <p class="aviso aviso--ok" role="status">
            Mensaje enviado. Te respondemos en cuanto podamos.
          </p>
        )
      }
      {
        state === 'datos' && (
          <p class="aviso aviso--mal" role="alert">
            {reason ?? 'Revisa los datos y vuelve a intentarlo.'}
          </p>
        )
      }
      {
        state === 'error' && (
          <p class="aviso aviso--mal" role="alert">
            No pudimos enviar el mensaje. Escríbenos directamente a{' '}
            <a href={`mailto:${HR_EMAIL}`}>{HR_EMAIL}</a>.
          </p>
        )
      }

      <form class="form" method="POST" action="/api/contact" data-contact-form>
        <fieldset class="topics">
          <legend>¿De qué se trata?</legend>
          {
            TOPICS.map((topic, i) => (
              <label class="topic">
                <input type="radio" name="topic" value={topic.id} required checked={i === 0} />
                <span class="topic__label">{topic.label}</span>
                <span class="topic__hint">{topic.hint}</span>
              </label>
            ))
          }
        </fieldset>

        <div class="fields">
          <label class="field">
            <span>Nombre</span>
            <input
              type="text"
              name="name"
              required
              minlength="2"
              maxlength="120"
              autocomplete="name"
            />
          </label>

          <label class="field">
            <span>Correo</span>
            <input type="email" name="email" required maxlength="200" autocomplete="email" />
          </label>

          <label class="field field--wide">
            <span>Empresa <small>(opcional)</small></span>
            <input type="text" name="company" maxlength="160" autocomplete="organization" />
          </label>

          <label class="field field--wide">
            <span>Mensaje</span>
            <textarea name="message" required minlength="10" maxlength="4000" rows="6"></textarea>
          </label>
        </div>

        {/* Hidden from people and from assistive tech; bots fill it anyway. */}
        <div class="honeypot" aria-hidden="true">
          <label>
            No llenes este field
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        {
          /*
          REQUIRED BEFORE LAUNCH. Mexico's LFPDPPP obliges whoever collects
          personal data to show an aviso de privacidad at the point of
          collection. /legal/privacidad/ is still unbuilt, so this link has no
          destination yet and the form must not be published until it does.
          The text is legal drafting: it names the responsable, the purposes
          and how to exercise ARCO rights, and it is not something to
          improvise.
        */
        }
        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>
            He leído y acepto el <a href="/legal/privacidad/">aviso de privacidad</a>.
          </span>
        </label>

        <button class="submit" type="submit">Enviar mensaje</button>
        <p class="form__status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="where section-shell" aria-labelledby="where-title">
      <header class="section-head section-head--dark">
        <h2 id="where-title" data-fx="up">Dónde estamos</h2>
      </header>

      <ul class="cards" data-fx-stagger>
        <li>
          <h3>Oficina</h3>
          <p>
            Calle Palo Santo 22, Piso 1<br />
            Lomas Altas, Miguel Hidalgo<br />
            11950 Ciudad de México
          </p>
        </li>
        <li>
          <h3>Teléfono</h3>
          <p><a href={`tel:${TELEPHONE.replace(/-/g, '')}`}>{TELEPHONE}</a></p>
        </li>
        <li>
          <h3>Talento</h3>
          <p><a href={`mailto:${HR_EMAIL}`}>{HR_EMAIL}</a></p>
        </li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .hero {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    text-transform: uppercase;
    font-size: clamp(2.5rem, 11vw, 7rem);
    line-height: var(--lh-display);
    margin: 0;
  }
  .lede {
    margin: var(--space-m) 0 0;
    font-size: 1.2rem;
    color: var(--color-dim);
    max-width: 40ch;
  }

  /* --- Avisos -------------------------------------------------------------- */
  .aviso {
    margin: 0 0 var(--space-l);
    padding: var(--space-s) var(--space-m);
    border-left: 3px solid var(--color-red);
    background: color-mix(in srgb, var(--color-fg) 5%, transparent);
  }
  .aviso--ok {
    border-left-color: var(--color-fg);
  }

  /* --- Temas --------------------------------------------------------------- */
  .topics {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-xl);
    display: grid;
    gap: var(--space-xs);
  }
  .topics legend {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: var(--color-dim);
    padding: 0;
    margin-bottom: var(--space-s);
  }

  .topic {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px var(--space-s);
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-line);
    cursor: pointer;
  }
  .topic input {
    grid-row: span 2;
    align-self: center;
    accent-color: var(--color-red);
    width: 1.15rem;
    height: 1.15rem;
  }
  .topic__label {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .topic__hint {
    font-size: 0.9rem;
    color: var(--color-dim);
  }
  .topic:has(input:checked) {
    border-color: var(--color-fg);
    background: color-mix(in srgb, var(--color-fg) 4%, transparent);
  }
  .topic:has(input:focus-visible) {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }

  /* --- Campos -------------------------------------------------------------- */
  .fields {
    display: grid;
    gap: var(--space-m);
  }
  .field {
    display: grid;
    gap: var(--space-2xs);
  }
  .field > span {
    font-size: 0.9rem;
  }
  .field small {
    color: var(--color-dim);
  }
  /* The phone and the email are links standing on their own in a list, not
     inline in a sentence, so WCAG 2.2 asks 24px of them. They were 20. Padding
     on the top only, so nothing moves down the card. */
  .cards p a {
    display: inline-block;
    padding-top: 5px;
  }

  .field input,
  .field textarea {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 0;
    border-bottom: 2px solid var(--color-line);
    padding: var(--space-xs) 0;
    /* The field was 21px tall on a phone, under the 24px WCAG 2.2 asks of a
       target. A form field that small is also just hard to hit. */
    min-height: 44px;
  }
  .field textarea {
    border: 2px solid var(--color-line);
    padding: var(--space-s);
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: 0;
    border-color: var(--color-red);
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The label IS the target for the checkbox inside it — a checkbox is 18px and
     nobody is expected to hit it — so the label is what has to clear the 24px
     WCAG 2.2 asks. It measured 23. One pixel, but a rule is a rule and this
     costs nothing. */
  .consent {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
    min-height: 24px;
    margin: var(--space-l) 0 0;
    font-size: 0.9rem;
  }
  .consent input {
    accent-color: var(--color-red);
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    margin-top: 2px;
  }

  .submit {
    margin-top: var(--space-l);
    font-family: var(--font-display);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-s) var(--space-l);
    border: 0;
    background: var(--color-fg);
    color: var(--color-bg);
    cursor: pointer;
  }
  .submit:hover {
    background: var(--color-red);
    color: #fafafa;
  }
  .submit[disabled] {
    opacity: 0.5;
    cursor: progress;
  }

  .form__status:empty {
    display: none;
  }
  .form__status {
    margin: var(--space-s) 0 0;
    font-size: 0.9rem;
  }

  /* --- Where we are -------------------------------------------------------- */
  .where {
    background: var(--color-dark);
    color: var(--color-on-dark);
    max-width: none;
  }
  .cards {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: var(--max-width);
    display: grid;
    gap: var(--space-l);
  }
  .cards h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: var(--color-red);
    margin: 0 0 var(--space-xs);
  }
  .cards p {
    margin: 0;
    line-height: 1.6;
  }
  .cards a {
    color: inherit;
  }

  @media (min-width: 48rem) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }
    .field--wide {
      grid-column: 1 / -1;
    }
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
    .form {
      max-width: 46rem;
    }
  }
</style>

<script>
  import { onPage } from '../lifecycle';

  /**
   * Enhancement only. Without it the form posts normally and the server
   * redirects back with the outcome in the query string; this just saves the
   * round trip and keeps what was typed when something fails.
   *
   * Per page: without this the form falls back to a full POST the moment
   * someone reaches /contact/ by navigating rather than by landing on it.
   */
  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    const status = document.querySelector<HTMLElement>('[data-form-status]');

    if (form && status) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (button) button.disabled = true;
        status.textContent = 'Enviando…';

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const data = await res.json();

          if (res.ok && data.ok) {
            form.reset();
            status.textContent = 'Mensaje enviado. Te respondemos en cuanto podamos.';
          } else {
            status.textContent =
              data.error === 'envio' || !data.error
                ? 'No pudimos enviar el mensaje. Escríbenos directamente.'
                : data.error;
          }
        } catch {
          /* Offline, or the endpoint is unreachable. Never claim it was sent. */
          status.textContent = 'No pudimos enviar el mensaje. Revisa tu conexión.';
        } finally {
          if (button) button.disabled = false;
        }
      });
    }
  });
</script>
