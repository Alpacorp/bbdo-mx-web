---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ScrollFX from '../components/ScrollFX.astro';
import { DEPARTMENTS, FALLBACK, classify } from '../departments';
import { themeStyle } from '../themes';

/**
 * /people/ — the BBDOers roster.
 *
 * 117 real people with name, role and portrait, migrated from
 * bbdomexico.com/bbdoers/. It is by far the richest content on the current
 * site, and the only page with structured data worth keeping as is.
 *
 * WHY IT IS BANDED AND NOT ONE GRID
 *   117 grayscale portraits on a light background read as one long white wall.
 *   Grouping by department gives the page structure, and giving each band its
 *   own palette is what actually cuts the white: only one of the seven bands
 *   stays light. The grouping is derived from the job title in
 *   src/departments.ts, not stored per person, so a new hire lands in the right
 *   band without anyone tagging them.
 *
 * THE HOVER, AND WHY IT IS NOT ONLY A HOVER
 *   The current site shows the portrait and reveals the role on hover. That
 *   reads well with a mouse and does not exist on touch: a phone has no hover
 *   state, so those details would simply never appear. The reveal is therefore
 *   gated behind `@media (hover: hover)`, and on touch the name and role are
 *   always visible under the portrait. Same information, two devices.
 *
 * THE SEARCH
 *   117 people is past the point where scanning works. The field filters by
 *   name and role as you type, hides empty bands, and is itself hidden without
 *   JS, because a filter that cannot filter is worse than no filter.
 */
const everyone = await getCollection('people');

const bands = [...DEPARTMENTS, FALLBACK]
  .map((dept) => ({
    dept,
    people: everyone
      .filter((p) => classify(p.data.role).id === dept.id)
      .sort((a, b) => a.data.name.localeCompare(b.data.name, 'es')),
  }))
  .filter((b) => b.people.length > 0);

/**
 * Portraits live in src/assets so Astro can optimise them, and the data only
 * carries the filename. import.meta.glob is the bridge between the two.
 */
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/people/*.{webp,jpg,jpeg,png}'
);

function portraitOf(file: string) {
  const key = `../assets/people/${file}`;
  if (!portraits[key]) throw new Error(`Missing portrait for ${file} in src/assets/people/`);
  return portraits[key]();
}
---

<Base
  title="BBDOers"
  path="/people/"
  description="Las personas de BBDO México: 117 BBDOers, de dirección creativa a producción, data y cuentas."
>
  <main id="content" class="people">
    <header class="intro">
      <h1 data-fx="lines"><span>BBDOers</span></h1>
      <p class="intro__note" data-fx="up" data-fx-delay="150">
        {everyone.length} personas · {bands.length} áreas
      </p>

      <form class="search" role="search" data-fx="up" data-fx-delay="250">
        <label class="search__label" for="buscar">Buscar persona o cargo</label>
        <input
          class="search__input"
          id="buscar"
          type="search"
          placeholder="Busca por nombre o cargo…"
          autocomplete="off"
        />
        <p class="search__count" aria-live="polite"></p>
      </form>
    </header>

    {
      bands.map((band) => (
        <section
          class="band"
          data-band={band.dept.id}
          data-theme={band.dept.theme}
          style={themeStyle(band.dept.theme)}
          aria-labelledby={`band-${band.dept.id}`}
        >
          <div class="band__inner">
            <header class="band__header">
              <h2 class="band__title" id={`band-${band.dept.id}`} data-fx="up">
                {band.dept.label}
              </h2>
              <p class="band__count" data-fx="up" data-fx-delay="100">
                {band.people.length}
              </p>
            </header>

            <ul class="roster" data-fx-stagger>
              {band.people.map(async (person) => {
                const img = (await portraitOf(person.data.photo)).default;
                return (
                  <li
                    class="person"
                    data-name={person.data.name.toLowerCase()}
                    data-role={person.data.role.toLowerCase()}
                  >
                    <Image
                      src={img}
                      alt={`Retrato de ${person.data.name}`}
                      widths={[280, 560]}
                      sizes="(max-width: 40rem) 45vw, (max-width: 60rem) 30vw, 22vw"
                      loading="lazy"
                      class="person__photo"
                    />
                    <button
                      class="person__toggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls={`info-${person.id}`}
                    >
                      <span class="sr-only">Ver el cargo de {person.data.name}</span>
                      <span class="person__toggle-mark" aria-hidden="true" />
                    </button>

                    <div class="person__info" id={`info-${person.id}`}>
                      <h3 class="person__name">{person.data.name}</h3>
                      <p class="person__role">{person.data.role}</p>
                      {person.data.quote && <p class="person__quote">{person.data.quote}</p>}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      ))
    }

    <p class="empty" hidden>Nadie coincide con esa búsqueda.</p>

    <ScrollFX />
  </main>
</Base>

<style>
  .intro {
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl) var(--space-xl);
    max-width: var(--max-width);
    margin-inline: auto;
  }
  .intro h1 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: var(--lh-display);
    text-transform: uppercase;
    margin: 0;
  }
  .intro__note {
    margin: var(--space-2xs) 0 0;
    color: var(--color-dim);
    font-size: 0.95rem;
  }

  /* --- Search --------------------------------------------------------------
     Hidden without JS: a filter that cannot filter is worse than none. */
  .search {
    display: none;
    margin-top: var(--space-l);
    max-width: 26rem;
  }
  :global(html.js) .search {
    display: block;
  }
  .search__label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin-bottom: var(--space-2xs);
  }
  .search__input {
    width: 100%;
    padding: var(--space-xs) 0;
    border: 0;
    border-bottom: 2px solid var(--color-line);
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.05rem;
  }
  .search__input:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
  }
  .search__count {
    margin: var(--space-xs) 0 0;
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--color-dim);
  }

  /* --- Bands ---------------------------------------------------------------
     Full bleed, each with its own palette. Only one of the seven stays light:
     that is what stops the page reading as a white wall. */
  .band {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    background: var(--case-background, var(--color-paper));
    color: var(--color-fg);
  }
  .band__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl);
  }

  .band__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-l);
  }
  .band__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.6rem, 4.5vw, 2.8rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .band__count {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: var(--color-accent);
  }

  .roster {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }

  .person {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.25);
    /* The source portraits are 800x1033. */
    aspect-ratio: 800 / 1033;
  }
  .person[hidden] {
    display: none;
  }

  .person__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Desaturated by default so the grid reads as one piece and colour becomes
       the reward for pointing at someone. */
    filter: grayscale(100%) contrast(1.05);
    transition:
      filter var(--dur-base) var(--ease),
      transform var(--dur-slow) var(--ease);
  }

  /* A solid panel and not a gradient veil. The veil relied on the photo being
     dark behind it, and roughly a third of these portraits are shot against
     white: on those the white text sat on near-white and was unreadable. A
     solid block guarantees contrast whatever the photo does, and brings brand
     colour into a page that was otherwise all grayscale.

     The brand red cannot be used here: #FF0000 with white text is 3.83:1 and
     fails AA. --color-red-deep is 7.51:1. */
  .person {
    --person-panel: var(--color-red-deep);
  }
  /* On the red band a red panel would vanish into the background. */
  .band[data-theme='red'] .person {
    --person-panel: var(--color-dark);
  }

  .person__info {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-s);
    color: #fafafa;
    background: var(--person-panel);
  }

  .person__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    line-height: 1.1;
  }
  .person__role {
    margin: 2px 0 0;
    font-size: clamp(0.75rem, 1.4vw, 0.9rem);
    color: rgba(250, 250, 250, 0.8);
  }
  .person__quote {
    margin: var(--space-xs) 0 0;
    font-size: 0.8rem;
    line-height: 1.35;
    color: rgba(250, 250, 250, 0.75);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .empty {
    padding: var(--space-2xl) var(--gutter);
    text-align: center;
    color: var(--color-dim);
  }

  /* --- The reveal -----------------------------------------------------------
     Hidden only when JS is available, because opening it needs either a hover
     or the toggle. Without JS the panel stays put and everyone can read it.

     Pointer devices open it on hover; touch devices open it on tap, through
     the toggle. The button exists on both: without a focusable element inside
     the card, keyboard users could not reach the role at all. */
  :global(html.js) .person__info {
    transform: translateY(101%);
    transition: transform var(--dur-base) var(--ease);
  }
  :global(html.js) .person.is-open .person__info {
    transform: translateY(0);
  }

  /* The handle.
     It was a filled red circle with a plus in it and it sat on the portrait
     like a sticker. This is the grabber of a bottom sheet instead: a hairline
     bar at the foot of the photo. It says "there is something under here"
     without competing with the face above it. The button around it is bigger
     than the bar it draws, because the visible mark is 3px tall and a touch
     target must not be. */
  .person__toggle {
    display: none;
    position: absolute;
    z-index: 1;
    inset: auto 0 0 0;
    width: 100%;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    place-items: center;
  }
  /* Only shown when it can do something. */
  :global(html.js) .person__toggle {
    display: grid;
  }
  .person__toggle-mark {
    display: block;
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: #fafafa;
    /* A hairline ring so the bar survives a white background, which is half
       of these portraits. */
    box-shadow: 0 0 0 1px rgb(0 0 0 / 18%);
    transition: transform var(--dur-fast) var(--ease);
  }
  .person__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  /* Once the panel is up it covers the handle anyway. */
  .person.is-open .person__toggle {
    opacity: 0;
    pointer-events: none;
  }

  /* A rule that draws itself across the top of the panel on entry. In paper
     and not in accent: on a red panel an accent-coloured rule disappears. */
  .person__info::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: #fafafa;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease) 0.1s;
  }
  .person.is-open .person__photo {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.04);
  }
  .person.is-open .person__info::before {
    transform: scaleX(1);
  }

  /* Hover only where a hover really exists: on touch, :hover sticks after a
     tap and would leave cards open at random. There the toggle does the job. */
  @media (hover: hover) {
    .person:hover .person__photo,
    .person:focus-within .person__photo {
      filter: grayscale(0%) contrast(1);
      transform: scale(1.04);
    }
    :global(html.js) .person:hover .person__info,
    :global(html.js) .person:focus-within .person__info {
      transform: translateY(0);
    }
    .person:hover .person__info::before,
    .person:focus-within .person__info::before {
      transform: scaleX(1);
    }
    /* On a mouse the handle is noise: hover already opens the card. But it is
       still the only way in from the keyboard, so it is hidden the way a skip
       link is — out of sight, in the tab order — and comes back on focus. */
    :global(html.js) .person__toggle {
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    :global(html.js) .person__toggle:focus-visible {
      width: auto;
      height: 30px;
      clip-path: none;
    }
  }

  @media (min-width: 40rem) {
    .roster {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 60rem) {
    .roster {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 80rem) {
    .roster {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .person__photo,
    .person__info,
    .person__info::before,
    .person__toggle,
    .person__toggle-mark::before {
      transition: none;
    }
  }

  @media (max-height: 32rem) {
    .intro,
    .band__inner {
      padding-block: var(--space-xl);
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('.search__input');
  const count = document.querySelector<HTMLElement>('.search__count');
  const empty = document.querySelector<HTMLElement>('.empty');
  const people = [...document.querySelectorAll<HTMLElement>('.person')];
  const bands = [...document.querySelectorAll<HTMLElement>('.band')];

  /**
   * The reveal.
   *
   * On a phone there is no hover, and leaving every panel up by default buried
   * the portraits under 117 red rectangles. So the card opens on tap. The
   * button is a real <button>, not a click handler on the <li>: that is what
   * gives the keyboard and a screen reader a way in on any device — before it
   * existed, nothing inside the card was focusable and the role was
   * unreachable without a mouse.
   *
   * One open at a time. Two half-open cards next to each other read as a bug.
   */
  function close(card: HTMLElement) {
    card.classList.remove('is-open');
    card.querySelector('.person__toggle')?.setAttribute('aria-expanded', 'false');
  }

  for (const card of people) {
    // The listener sits on the card, not on the handle: on a phone the handle
    // is a 28px hint and the whole portrait is the target. The button's own
    // click bubbles up to here, so both routes end in the same place.
    card.addEventListener('click', () => {
      const wasOpen = card.classList.contains('is-open');
      for (const other of people) if (other !== card) close(other);

      card.classList.toggle('is-open', !wasOpen);
      card.querySelector('.person__toggle')?.setAttribute('aria-expanded', String(!wasOpen));
    });
  }

  // A tap outside closes whatever is open, the way any popover behaves.
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.person')) return;
    for (const card of people) close(card);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const card of people) close(card);
  });

  if (input && count && empty) {
    /**
     * Accents are stripped from both sides so "Martinez" finds "Martínez".
     * Typing an accent on a phone keyboard is friction nobody should need to
     * find a colleague.
     */
    const plain = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '');

    const haystack = new Map(
      people.map((p) => [p, plain(`${p.dataset.name ?? ''} ${p.dataset.role ?? ''}`)])
    );

    function filter() {
      const q = plain(input!.value.trim().toLowerCase());
      let shown = 0;

      for (const person of people) {
        const match = !q || (haystack.get(person) ?? '').includes(q);
        person.hidden = !match;
        if (!match) close(person);
        if (match) shown += 1;
      }

      // A band with nothing left in it is noise: hide the heading too.
      for (const band of bands) {
        const any = [...band.querySelectorAll<HTMLElement>('.person')].some((p) => !p.hidden);
        band.hidden = !any;
      }

      empty!.hidden = shown > 0;
      count!.textContent = q ? `${shown} de ${people.length}` : '';
    }

    input.addEventListener('input', filter);
    // Esc clears, which is what the native search field's × already suggests.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.value = '';
        filter();
      }
    });
  }
</script>
