---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ScrollFX from '../components/ScrollFX.astro';
import { DEPARTMENTS, FALLBACK, classify } from '../departments';
import { portraitOf } from '../portraits';
import { themeStyle } from '../themes';

/**
 * /people/ — the BBDOers roster.
 *
 * 117 real people with name, role and portrait, migrated from
 * bbdomexico.com/bbdoers/. It is by far the richest content on the current
 * site, and the only page with structured data worth keeping as is.
 *
 * WHY IT IS BANDED AND NOT ONE GRID
 *   117 grayscale portraits on a light background read as one long white wall.
 *   Grouping by department gives the page structure, and giving each band its
 *   own palette is what actually cuts the white: only one of the seven bands
 *   stays light. The grouping is derived from the job title in
 *   src/departments.ts, not stored per person, so a new hire lands in the right
 *   band without anyone tagging them.
 *
 * THE HOVER, AND WHY IT IS NOT ONLY A HOVER
 *   The current site shows the portrait and reveals the role on hover. That
 *   reads well with a mouse and does not exist on touch: a phone has no hover
 *   state, so those details would simply never appear. The reveal is therefore
 *   gated behind `@media (hover: hover)`, and on touch the name and role are
 *   always visible under the portrait. Same information, two devices.
 *
 * THE SEARCH
 *   117 people is past the point where scanning works. The field filters by
 *   name and role as you type, hides empty bands, and is itself hidden without
 *   JS, because a filter that cannot filter is worse than no filter.
 */
const everyone = await getCollection('people');

const bands = [...DEPARTMENTS, FALLBACK]
  .map((dept) => ({
    dept,
    people: everyone
      .filter((p) => classify(p.data.role).id === dept.id)
      /* `order` first, then alphabetical. The field was in the schema from the
         start, documented as "lowest first", and nothing read it: an ordering
         the data promised and the page ignored. */
      .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name, 'es')),
  }))
  .filter((b) => b.people.length > 0);
---

<Base
  title="BBDOers"
  path="/people/"
  description="Las personas de BBDO México: 117 BBDOers, de dirección creativa a producción, data y cuentas."
>
  <main id="content" class="people">
    <header class="intro">
      <h1 class="page-title" data-fx="lines"><span>BBDOers</span></h1>
      <p class="intro__note" data-fx="up" data-fx-delay="150">
        {everyone.length} personas · {bands.length} áreas
      </p>

      <form class="search" role="search" data-fx="up" data-fx-delay="250">
        <label class="search__label" for="buscar">Buscar persona o cargo</label>
        <input
          class="search__input"
          id="buscar"
          type="search"
          placeholder="Busca por nombre o cargo…"
          autocomplete="off"
        />
        <p class="search__count" aria-live="polite"></p>
      </form>
    </header>

    {
      bands.map((band) => (
        <section
          class="band"
          data-band={band.dept.id}
          data-theme={band.dept.theme}
          style={themeStyle(band.dept.theme)}
          aria-labelledby={`band-${band.dept.id}`}
        >
          <div class="band__inner">
            <header class="band__header">
              <h2 class="band__title" id={`band-${band.dept.id}`} data-fx="up">
                {band.dept.label}
              </h2>
              <p class="band__count" data-fx="up" data-fx-delay="100">
                {band.people.length}
              </p>
            </header>

            <ul class="roster" data-fx-stagger>
              {band.people.map(async (person) => {
                const img = (await portraitOf(person.data.photo)).default;
                return (
                  <li
                    class="person"
                    data-name={person.data.name.toLowerCase()}
                    data-role={person.data.role.toLowerCase()}
                  >
                    <span class="person__frame">
                      <Image
                        src={img}
                        alt={`Retrato de ${person.data.name}`}
                        widths={[280, 560]}
                        sizes="(max-width: 40rem) 45vw, (max-width: 60rem) 30vw, 22vw"
                        loading="lazy"
                        class="person__photo"
                      />
                    </span>

                    <div class="person__info">
                      <h3 class="person__name">{person.data.name}</h3>
                      <p class="person__role">{person.data.role}</p>
                      {person.data.quote && <p class="person__quote">{person.data.quote}</p>}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      ))
    }

    <p class="empty" hidden>Nadie coincide con esa búsqueda.</p>

    <ScrollFX />
  </main>
</Base>

<style>
  .intro {
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl) var(--space-xl);
    max-width: var(--max-width);
    margin-inline: auto;
  }
  .intro h1 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: var(--lh-display);
    text-transform: uppercase;
    margin: 0;
  }
  .intro__note {
    margin: var(--space-2xs) 0 0;
    color: var(--color-dim);
    font-size: 0.95rem;
  }

  /* --- Search --------------------------------------------------------------
     Hidden without JS: a filter that cannot filter is worse than none. */
  .search {
    display: none;
    margin-top: var(--space-l);
    max-width: 26rem;
  }
  :global(html.js) .search {
    display: block;
  }
  .search__label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin-bottom: var(--space-2xs);
  }
  .search__input {
    width: 100%;
    padding: var(--space-xs) 0;
    border: 0;
    border-bottom: 2px solid var(--color-line);
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.05rem;
  }
  .search__input:focus {
    outline: none;
    border-bottom-color: var(--color-accent);
  }
  .search__count {
    margin: var(--space-xs) 0 0;
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--color-dim);
  }

  /* --- Bands ---------------------------------------------------------------
     Full bleed, each with its own palette. Only one of the seven stays light:
     that is what stops the page reading as a white wall. */
  .band {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    background: var(--case-background, var(--color-paper));
    color: var(--color-fg);
  }
  .band__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl);
  }

  .band__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-l);
  }
  .band__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.6rem, 4.5vw, 2.8rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .band__count {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: var(--color-accent);
  }

  .roster {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }

  /* --- The card ------------------------------------------------------------
     The name and the role used to live in a panel that slid up over the
     portrait on hover or on tap. On a desktop that left 117 anonymous faces
     and made finding one person a hunt: on a team page the name IS the
     content, not the reward for pointing at it.

     So the frame holds the portrait and the name sits under it, the way
     /about/ already shows the leadership grid. The interaction that is left
     is the one that adds something instead of hiding something: the portrait
     comes into colour.

     Only one of the 117 records carries a quote, which is the other reason
     the panel is gone — it existed almost entirely to hold text that fits
     perfectly well underneath. */
  .person {
    display: flex;
    flex-direction: column;
  }
  .person[hidden] {
    display: none;
  }

  .person__frame {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.25);
    /* The source portraits are 800x1033. */
    aspect-ratio: 800 / 1033;
  }

  .person__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Desaturated by default so the grid reads as one piece and colour becomes
       the reward for pointing at someone. */
    filter: grayscale(100%) contrast(1.05);
    transition:
      filter var(--dur-base) var(--ease),
      transform var(--dur-slow) var(--ease);
  }

  /* No panel means no fixed white-on-red to keep legible: the text sits on the
     band, and themeStyle() has already recomputed --color-fg and --color-dim
     from that band's palette, with the contrast validated on import. */
  .person__info {
    padding-top: var(--space-xs);
  }

  .person__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    line-height: 1.15;
    transition: color var(--dur-fast) var(--ease);
  }
  .person__role {
    margin: 2px 0 0;
    font-size: clamp(0.75rem, 1.4vw, 0.9rem);
    color: var(--color-dim);
  }
  .person__quote {
    margin: var(--space-xs) 0 0;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-dim);
  }

  .empty {
    padding: var(--space-2xl) var(--gutter);
    text-align: center;
    color: var(--color-dim);
  }

  /* The only thing left of the old reveal: the portrait comes into colour.
     Nothing is hidden behind it any more, so there is nothing to open, no
     handle to draw and no focus trap to manage — which is why the toggle
     button and its script are gone rather than merely hidden. */
  @media (hover: hover) {
    .person:hover .person__photo {
      filter: grayscale(0%) contrast(1);
      transform: scale(1.04);
    }
    .person:hover .person__name {
      color: var(--color-accent);
    }
  }

  @media (min-width: 40rem) {
    .roster {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 60rem) {
    .roster {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 80rem) {
    .roster {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .person__photo,
    .person__name {
      transition: none;
    }
  }

  @media (max-height: 32rem) {
    .intro,
    .band__inner {
      padding-block: var(--space-xl);
    }
  }
</style>

<script>
  import { onPage } from '../lifecycle';

  /* Per page: the roster and the search box are replaced on every navigation,
     and a handler bound to the old input would keep filtering a list that is
     no longer on screen. */
  onPage(() => {
    const input = document.querySelector<HTMLInputElement>('.search__input');
    const count = document.querySelector<HTMLElement>('.search__count');
    const empty = document.querySelector<HTMLElement>('.empty');
    const people = [...document.querySelectorAll<HTMLElement>('.person')];
    const bands = [...document.querySelectorAll<HTMLElement>('.band')];

    if (input && count && empty) {
      /**
       * Accents are stripped from both sides so "Martinez" finds "Martínez".
       * Typing an accent on a phone keyboard is friction nobody should need to
       * find a colleague.
       */
      const plain = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '');

      const haystack = new Map(
        people.map((p) => [p, plain(`${p.dataset.name ?? ''} ${p.dataset.role ?? ''}`)])
      );

      function filter() {
        const q = plain(input!.value.trim().toLowerCase());
        let shown = 0;

        for (const person of people) {
          const match = !q || (haystack.get(person) ?? '').includes(q);
          person.hidden = !match;
          if (match) shown += 1;
        }

        // A band with nothing left in it is noise: hide the heading too.
        for (const band of bands) {
          const any = [...band.querySelectorAll<HTMLElement>('.person')].some((p) => !p.hidden);
          band.hidden = !any;
        }

        empty!.hidden = shown > 0;
        count!.textContent = q ? `${shown} de ${people.length}` : '';
      }

      input.addEventListener('input', filter);
      // Esc clears, which is what the native search field's × already suggests.
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          input.value = '';
          filter();
        }
      });
    }
  });
</script>
