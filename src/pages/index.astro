---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoBanner from '../components/VideoBanner.astro';
import VideoHeadline from '../components/VideoHeadline.astro';
import ScrollFX from '../components/ScrollFX.astro';
import ClientWall from '../components/ClientWall.astro';

/**
 * Home page.
 *
 * Structure from the global site (see docs/referencia-visual-bbdo-global.md):
 *   1. video-banner-section   <- was missing; this is the "hero banner"
 *   2. contact-section        headline with clips + positioning paragraph
 *   3. work-section
 *   4. news-section
 *
 * What we add and the global site does NOT have, as a market difference:
 *   5. Clients — the current site has /nuestros-clientes/ with 985 words. It is
 *                MX-owned content that should not be lost in the migration.
 *   6. Awards  — a Mexican agency sells on local awards, and the per-case
 *                JSON-LD already reserves an `award` field.
 *
 * VIDEO PLACEHOLDER: /v/banner-home.mp4 is head-team.mp4 from the current site
 * (30.83 MB, 14.9s), downloaded by hand and picked by the developer. That is
 * twelve times the 2.5 MB budget for the whole hero (section 6 of the brief).
 * It is there to judge the clip's framing and tone, NOT to measure performance:
 * a Lighthouse run with this in place reports an unreal LCP. The binary is not
 * versioned, see .gitignore.
 *
 * WATCH THE COPY: every string here is PLACEHOLDER written by me. The brand
 * platform ("Do Big Things" localised vs. MX-specific language) is an open
 * section 10 decision and belongs to the creative director. Do not present
 * these words as proposed copy.
 */

const clips = [
  { after: 0, src: '/v/modelo.mp4', poster: '/v/modelo.png', label: '01', size: 'sm' as const },
  { after: 1, src: '/v/pepsi.mp4', poster: '/v/pepsi.png', label: '02', size: 'lg' as const },
  { after: 2, src: '/v/banamex.mp4', poster: '/v/banamex.png', label: '03', size: 'md' as const },
];

// Cases come from the collection, not a hand-written array: a single source of
// truth shared with /the-work/. `featured` decides which ones reach the home.
const cases = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

/**
 * The REAL roster, read off the client wall on bbdomexico.com. It replaces the
 * invented list that was here before, which was almost entirely wrong.
 *
 * MIND THE AGE: the assets for Buchanan's, Johnnie Walker, Saba, Finamex,
 * Pedigree, Tostitos, Norteñita, Olé and Oscar Mayer were uploaded in 2018;
 * San Rafael, Mirinda, Pepsi, Yoplait, BMW and MINI between 2023 and 2025. The
 * agency has to confirm which are still live accounts before publishing: a
 * client that no longer is one cannot appear here.
 */

// Placeholder figures. Marketing has to confirm them before publishing.
const awards = [
  { figure: '00', name: 'Leones en Cannes', note: 'pendiente de confirmar' },
  { figure: '00', name: 'Círculo de Oro', note: 'pendiente de confirmar' },
  { figure: '00', name: 'El Sol', note: 'pendiente de confirmar' },
  { figure: '00', name: 'Effie México', note: 'pendiente de confirmar' },
];

const noticias = [
  {
    titulo: 'BBDO México, reconocida como Agencia Transformadora del Año',
    fecha: '2024-11-26',
    slug: 'bbdo-premio-agencia-transformadora',
    img: '/v/case-modelo.png',
    extracto: 'El único contenido real que hoy existe en el sitio actual. Se migra tal cual.',
  },
  {
    titulo: 'Titular de noticia pendiente de curaduría',
    fecha: '2025-06-01',
    slug: 'placeholder-2',
    img: '/v/case-telcel.png',
    extracto:
      'Texto de relleno. El índice de noticias hoy no existe: el menú NEWS apunta a un post suelto.',
  },
  {
    titulo: 'Titular de noticia pendiente de curaduría',
    fecha: '2025-09-15',
    slug: 'placeholder-3',
    img: '/v/case-cerveza.png',
    extracto: 'Texto de relleno.',
  },
];

/**
 * new Date('2024-11-26') parses as midnight UTC, and formatting it in Mexico's
 * timezone (UTC-6) rolls back a day: it printed "25 de noviembre". Splitting
 * the string forces local interpretation.
 */
function fechaLarga(iso: string) {
  const [a, m, d] = iso.split('-').map(Number);
  return new Date(a, m - 1, d).toLocaleDateString('es-MX', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base
  title="BBDO México"
  path="/"
  isHome
  overMedia
  description="BBDO México es una de las agencias de publicidad más premiadas del país y forma parte de BBDO Worldwide, red creativa de Omnicom Group."
>
  <main id="content">
    {
      /* In English and split across the two corners, like the global site:
          "Do Big Things" is a global campaign and the banner leaves it in its
          own language. The video in between is the missing word, "BIG". The
          Spanish localisation lives in the headline below, not here. */
    }
    <VideoBanner left="Do" right="Things" src="/v/banner-home.mp4" poster="/v/banner-home.png" />

    {
      /* Content wrapper. The banner is sticky, and sticky is a positioned
        element: it paints above everything that is not. Without this wrapper,
        work / awards / news (static and with no background) sat UNDER the
        banner and disappeared on scroll. The global site does the same with
        section.main-content-container. */
    }
    <div class="contenido">
      <section class="claim">
        {
          /* The '|' forces the break, so "Do Big Things" stays on one line
            instead of wrapping wherever the width happens to fall. */
        }
        <VideoHeadline
          words={['Somos', 'BBDO', 'México', '|', 'Do', 'Big', 'Things']}
          accentIndex={-1}
          clips={clips}
          etiqueta="h1"
        />
        <p class="claim__text" data-fx="up">
          Resolvemos problemas grandes con estrategia e ideas que dejan huella. Trabajamos con las
          marcas más ambiciosas de México. Contratamos talento grande y le damos oportunidades
          grandes.
        </p>
        <a class="claim__cta" data-fx="up" data-fx-delay="0.15" href="/contact/"
          >¿Quieres hacer cosas grandes?</a
        >
      </section>

      <section class="work" aria-labelledby="work-title">
        <header class="section-head">
          <h2 id="work-title" data-fx="up">The Work</h2>
          <a class="section-link" href="/the-work/">Ver todo The Work</a>
        </header>

        <ul class="grid" data-fx-stagger>
          {
            cases.map((c, i) => (
              <li class:list={['card', i === 0 && 'card--wide']}>
                <a href={`/the-work/${c.id}/`}>
                  <Image
                    src={c.data.image}
                    alt={c.data.imageAlt}
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 33vw"
                    loading="lazy"
                  />
                  <h3 class="card__brand">{c.data.brand}</h3>
                  <p class="card__campaign">{c.data.campaign}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <ClientWall />

      <section class="awards" aria-labelledby="premios-title">
        <header class="section-head">
          <h2 id="premios-title" data-fx="up">Premios</h2>
        </header>
        <ul class="awards__list" data-fx-stagger>
          {
            awards.map((p) => (
              <li>
                <span class="awards__figure">{p.figure}</span>
                <span class="awards__name">{p.name}</span>
                <span class="awards__note">{p.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="news" aria-labelledby="news-title">
        <header class="section-head">
          <h2 id="news-title" data-fx="up">Do Big Things</h2>
          <a class="section-link" href="/news/">Ver todas las noticias</a>
        </header>

        <ul class="news-list" data-fx-stagger>
          {
            noticias.map((n) => (
              <li>
                <a href={`/news/${n.slug}/`}>
                  <img
                    src={n.img}
                    alt=""
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="news-list__body">
                    <time datetime={n.fecha}>{fechaLarga(n.fecha)}</time>
                    <h3>{n.titulo}</h3>
                    <p>{n.extracto}</p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <ScrollFX />
  </main>
</Base>

<style>
  /* --- Claim: titular + posicionamiento, sobre rojo pleno --------------- */
  /* Everything after the banner, on a single layer above it. The solid
     background is mandatory: without it the sticky banner shows through the
     sections that carry no background of their own. */
  .contenido {
    position: relative;
    z-index: 1;
    background: var(--color-paper);
  }

  .claim {
    background: var(--color-red);
    color: var(--color-on-dark);
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-l);
  }
  .claim__text {
    max-width: 46ch;
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.5rem);
    line-height: 1.45;
  }
  .claim__cta {
    align-self: start;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 3px solid currentColor;
    padding-bottom: 4px;
  }

  /* --- Secciones claras -------------------------------------------------- */
  .work,
  .awards,
  .news {
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl);
    max-width: var(--max-width);
    margin-inline: auto;
  }

  /* --- Work: grid asimetrica ----------------------------------------- */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l) var(--space-m);
  }
  /* The first case spans two columns: it breaks the flat grid. */
  .card--wide {
    grid-column: span 2;
  }

  .card a {
    text-decoration: none;
    display: block;
  }
  .card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-dark);
  }
  .card--wide img {
    aspect-ratio: 21 / 9;
  }
  .card__brand {
    font-family: var(--font-display);
    font-weight: 400; /* the global site uses 400 here, not 600 */
    font-size: var(--size-case-brand);
    line-height: 1.1;
    margin: var(--space-s) 0 var(--space-2xs);
  }
  .card__campaign {
    margin: 0;
    color: var(--color-dim);
    font-size: 0.95rem;
  }
  .card a:hover .card__brand {
    color: var(--color-red);
  }

  /* --- Premios ----------------------------------------------------------- */
  .awards__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 8rem and not 10: a 375px phone leaves 335px usable, and two 10rem
       columns plus the 24px gap add up to 344. At 8rem they total 280 and fit. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--space-l) var(--space-m);
  }
  .awards__list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .awards__figure {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    /* 2.5rem floor: at two columns on mobile, 3rem ate the width. */
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1;
    color: var(--color-red);
  }
  .awards__name {
    font-size: 1.05rem;
  }
  .awards__note {
    font-size: 0.8rem;
    color: var(--color-dim);
  }

  /* --- Noticias ---------------------------------------------------------- */
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-l) var(--space-m);
  }
  .news-list a {
    text-decoration: none;
    display: block;
  }
  .news-list img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-dark);
  }
  .news-list__body {
    padding-top: var(--space-s);
  }
  .news-list time {
    color: var(--color-dim);
    font-size: 0.85rem;
  }
  .news-list h3 {
    margin: var(--space-2xs) 0 var(--space-xs);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    line-height: 1.2;
  }
  .news-list p {
    margin: 0;
    color: var(--color-dim);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .news-list a:hover h3 {
    color: var(--color-red);
  }

  /* Short screens (landscape phone): 96px of padding top and bottom eats half
     of a 390px-tall viewport. */
  @media (max-height: 32rem) {
    .claim {
      min-height: auto;
      padding-block: var(--space-xl);
      gap: var(--space-m);
    }
    .work,
    .awards,
    .news {
      padding-block: var(--space-xl);
    }
    .clients__inner {
      padding-block: var(--space-xl);
    }
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .card--wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card--wide {
      grid-column: span 1;
    }
    .card--wide img {
      aspect-ratio: 16 / 9;
    }
  }
</style>
