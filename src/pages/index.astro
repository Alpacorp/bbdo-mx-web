---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoBanner from '../components/VideoBanner.astro';
import VideoHeadline from '../components/VideoHeadline.astro';
import ScrollFX from '../components/ScrollFX.astro';
import Process from '../components/Process.astro';
import ClientWall from '../components/ClientWall.astro';
import Awards from '../components/Awards.astro';
import KineticBand from '../components/KineticBand.astro';
import { PLATFORM_WORDS, PLATFORM_CORNERS, PLATFORM_ECHO } from '../platform';
import NewsCard from '../components/NewsCard.astro';

/**
 * The three most recent articles. Real ones: the home used to carry two
 * invented entries titled "Titular de noticia pendiente de curaduría", and
 * they linked to /news/, which did not exist. With one article published the
 * strip shows one.
 */
const latest = (await getCollection('news'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

/**
 * Home page.
 *
 * Structure from the global site (see docs/referencia-visual-bbdo-global.md):
 *   1. video-banner-section   <- was missing; this is the "hero banner"
 *   2. contact-section        headline with clips + positioning paragraph
 *   3. work-section
 *   4. news-section
 *
 * What we add and the global site does NOT have, as a market difference:
 *   5. Process — the four B-B-D-O steps, recovered from bbdomexico.com's
 *                /our-process/ page. See src/process.ts.
 *   6. Clients — the current site has /nuestros-clientes/ with 985 words. It is
 *                MX-owned content that should not be lost in the migration.
 *   7. Awards  — a Mexican agency sells on local awards, and the per-case
 *                JSON-LD already reserves an `award` field.
 *
 * THE BANDS ALTERNATE. Reading down: claim red, process dark, work paper,
 * clients dark, awards paper, kinetic band dark, news --color-dark-alt. Anything inserted between them has to
 * keep that going or the page flattens out, which is what it did before.
 *
 * VIDEO PLACEHOLDER: /v/banner-home.mp4 is head-team.mp4 from the current site
 * (30.83 MB, 14.9s), downloaded by hand and picked by the developer. That is
 * twelve times the 2.5 MB budget for the whole hero (section 6 of the brief).
 * It is there to judge the clip's framing and tone, NOT to measure performance:
 * a Lighthouse run with this in place reports an unreal LCP. The binary is not
 * versioned, see .gitignore.
 *
 * WATCH THE COPY: every string here is PLACEHOLDER written by me. The brand
 * platform ("Do Big Things" localised vs. MX-specific language) is an open
 * section 10 decision and belongs to the creative director. Do not present
 * these words as proposed copy. When it is decided, it changes in ONE place:
 * src/platform.ts. The banner, the headline, the kinetic band and the CTA all
 * read it from there.
 */

/**
 * THESE THREE ARE PLACEHOLDERS AND THE NAMES DO NOT DESCRIBE THEM. Opened
 * frame by frame while compressing them on 2026-08-28: all three are kinetic
 * title cards from the current site — "THE WORK", "BBDOERS" — and none of them
 * contains a frame of Modelo, Pepsi or Banamex. Same debt as banner-home.mp4
 * below. When real campaign clips arrive, the poster has to be regenerated
 * from each one: the recipe is in section 6 of the brief.
 *
 * The posters ARE frames of their own clip now, taken at t=0 so there is no
 * jump when the video starts. They used to be 600x400 gradients with nothing
 * in them, at an aspect no slot uses.
 */
const clips = [
  { after: 0, src: '/v/modelo.mp4', poster: '/v/modelo.webp', label: '01', size: 'sm' as const },
  { after: 1, src: '/v/pepsi.mp4', poster: '/v/pepsi.webp', label: '02', size: 'lg' as const },
  { after: 2, src: '/v/banamex.mp4', poster: '/v/banamex.webp', label: '03', size: 'md' as const },
];

// Cases come from the collection, not a hand-written array: a single source of
// truth shared with /the-work/. `featured` decides which ones reach the home.
const cases = (await getCollection('work', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

/**
 * The REAL roster, read off the client wall on bbdomexico.com. It replaces the
 * invented list that was here before, which was almost entirely wrong.
 *
 * MIND THE AGE: the assets for Buchanan's, Johnnie Walker, Saba, Finamex,
 * Pedigree, Tostitos, Norteñita, Olé and Oscar Mayer were uploaded in 2018;
 * San Rafael, Mirinda, Pepsi, Yoplait, BMW and MINI between 2023 and 2025. The
 * agency has to confirm which are still live accounts before publishing: a
 * client that no longer is one cannot appear here.
 */

// Placeholder figures. Marketing has to confirm them before publishing.
---

<Base
  title="BBDO México"
  path="/"
  isHome
  overMedia
  description="BBDO México es una de las agencias de publicidad más premiadas del país y forma parte de BBDO Worldwide, red creativa de Omnicom Group."
>
  <main id="content">
    {
      /* In English and split across the two corners, like the global site:
          "Do Big Things" is a global campaign and the banner leaves it in its
          own language. The video in between is the missing word, "BIG". The
          Spanish localisation lives in the headline below, not here. */
    }
    <VideoBanner
      left={PLATFORM_CORNERS.left}
      right={PLATFORM_CORNERS.right}
      src="/v/banner-home.mp4"
      poster="/v/banner-home.webp"
    />

    {
      /* Content wrapper. The banner is sticky, and sticky is a positioned
        element: it paints above everything that is not. Without this wrapper,
        work / awards / news (static and with no background) sat UNDER the
        banner and disappeared on scroll. The global site does the same with
        section.main-content-container. */
    }
    <div class="content">
      <section class="claim">
        {
          /* The '|' forces the break, so "Do Big Things" stays on one line
            instead of wrapping wherever the width happens to fall. */
        }
        <VideoHeadline
          words={['Somos', 'BBDO', 'México', '|', ...PLATFORM_WORDS]}
          accentIndex={-1}
          clips={clips}
          tag="h1"
        />
        <p class="claim__text" data-fx="up">
          Resolvemos problemas grandes con estrategia e ideas que dejan huella. Trabajamos con las
          marcas más ambiciosas de México. Contratamos talento grande y le damos oportunidades
          grandes.
        </p>
        <a class="claim__cta" data-fx="up" data-fx-delay="0.15" href="/contact/">{PLATFORM_ECHO}</a>
      </section>

      <Process />

      <section class="work section-shell" aria-labelledby="work-title">
        <span class="section-rail" aria-hidden="true">Work</span>
        <header class="section-head">
          <h2 id="work-title" data-fx="up">The Work</h2>
          <a class="section-link" href="/the-work/">Ver todo The Work</a>
        </header>

        <ul class="grid" data-fx-stagger>
          {
            cases.map((c, i) => (
              <li class:list={['card', i === 0 && 'card--wide']}>
                <a href={`/the-work/${c.id}/`} data-morph>
                  {/* The lead card is 58vw at three columns and the rest are
                       28vw. One blanket 33vw could not say that, so all six
                       were picked from the same declaration.

                       Measured, the difference shows on 1x screens: the lead
                       takes 1200w and the five others drop to 800w, 183 KB
                       against 265. On a 2x screen every card needs 1200 — even
                       a small one wants 832 device pixels and 800 would be
                       serving under. That is correct, not waste.

                       The lead cannot fill a 2x screen at all: it needs 1712
                       and the sources are 1280x720 Vimeo thumbnails, so 1200
                       is the ceiling. That is the audit's A1 — key art, not
                       code. */}
                  <Image
                    src={c.data.image}
                    alt={c.data.imageAlt}
                    widths={[400, 800, 1200]}
                    sizes={
                      i === 0
                        ? '(min-width: 64rem) 58vw, (min-width: 40rem) 50vw, 100vw'
                        : '(min-width: 64rem) 28vw, (min-width: 40rem) 50vw, 100vw'
                    }
                    loading="lazy"
                    transition:name={`cover-${c.id}`}
                  />
                  <h3 class="card__brand">{c.data.brand}</h3>
                  <p class="card__campaign">{c.data.campaign}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <ClientWall />

      <Awards />

      {
        /* The third beat of the platform, between the awards and the news. It
           keeps the band alternation going — awards on paper, this on dark,
           news on --color-dark-alt — and it is the only thing on the page that
           moves because the reader moves. */
      }
      <KineticBand />

      <section class="news" aria-labelledby="news-title">
        <div class="news__inner section-shell">
          <span class="section-rail" aria-hidden="true">News</span>
          <header class="section-head section-head--dark">
            <h2 id="news-title" data-fx="up">Noticias</h2>
            <a class="section-link" href="/news/">Ver todas</a>
          </header>

          <ul class="news-list" data-fx-stagger>
            {
              latest.map((entry) => (
                <li>
                  <NewsCard entry={entry} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

    <ScrollFX />
  </main>
</Base>

<style>
  /* --- Claim: titular + posicionamiento, sobre rojo pleno --------------- */
  /* Everything after the banner, on a single layer above it. The solid
     background is mandatory: without it the sticky banner shows through the
     sections that carry no background of their own. */
  .content {
    position: relative;
    z-index: 1;
    background: var(--color-paper);
  }

  .claim {
    background: var(--color-red);
    color: var(--color-on-dark);
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-l);
  }
  /* White on #ff0000 is 4.0:1, which WCAG clears only as large text. The first
     pass set this to 600 reading "18.66px and bold"; the checker disagreed, and
     it is right to: bold means 700, and at 600 this was still being measured
     against the 4.5:1 threshold for normal text. 700 at 19.2px and up is large
     text, where the bar is 3:1. Both numbers here are the constraint, not a
     preference. */
  .claim__text {
    max-width: 46ch;
    margin: 0;
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 700;
    line-height: 1.45;
  }
  /* The same pill as .section-link, on the red band: this is the global site's
     CONTACT US. Its own rule rather than the shared class because the section
     link inverts to red on hover, and on a red band that would erase it. */
  .claim__cta {
    align-self: start;
    font-family: var(--font-display);
    /* 700 and not --weight-display, same reason as .claim__text above: on the
       red band nothing below bold counts as large text. */
    font-weight: 700;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    border: 3px solid currentColor;
    border-radius: 999px;
    padding: 0.5em 1.5em;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .claim__cta:hover,
  .claim__cta:focus-visible {
    background: var(--color-on-dark);
    color: var(--color-red);
  }

  /* --- Work: asymmetric grid -------------------------------------------
     SIX CARDS, ONE OF THEM DOUBLE, IS SEVEN CELLS. Seven divides by neither
     three nor two, and that arithmetic was the whole complaint: measured on
     the build, the grid box came out 27% empty at 1512 and 32% at 768. A
     column's worth of nothing sat under the third card of row one, and the
     last row carried one card against two blank cells.

     So the span exists only at the width where six cards fill the shape
     exactly. Three columns, the lead case two wide AND two tall, two stacked
     beside it, three underneath:

         0 0 1
         0 0 2
         3 4 5

     Below that the lead is an ordinary card and the grid is flat — two columns
     by three, then one — because at two columns a double-wide card puts the
     hole straight back.

     AND IT HAD NO BREAKPOINTS AT ALL. Three columns held down to 390px, where
     each card was 101px wide with its brand name wrapped over three lines
     beside a thumbnail smaller than the type. This section never got the
     mobile-first pass section 6 calls obligatory. */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l) var(--space-m);
  }

  .card a {
    text-decoration: none;
    display: block;
  }
  .card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-dark);
  }
  .card__brand {
    font-family: var(--font-display);
    font-weight: 400; /* the global site uses 400 here, not 600 */
    font-size: var(--size-case-brand);
    line-height: 1.1;
    margin: var(--space-s) 0 var(--space-2xs);
  }
  .card__campaign {
    margin: 0;
    color: var(--color-dim);
    font-size: 0.95rem;
  }
  .card a:hover .card__brand {
    color: var(--color-red);
  }

  /* Two columns, flat: six ordinary cards are three clean rows. */
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Three columns, and the lead case becomes the protagonist. It spans two
     rows as well as two columns, so the pair stacked beside it defines the
     height and nothing is left over. */
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .card--wide {
      grid-column: span 2;
      grid-row: span 2;
    }
    /* The card's own box has to become the layout, or the image keeps its
       intrinsic height and the second row shows up as space under the caption
       instead of as picture. 1fr takes the picture, auto takes the two lines
       of type. */
    .card--wide a {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto auto;
      height: 100%;
    }
    /* aspect-ratio is dropped rather than retuned: the height comes from the
       two cards beside it now, and a ratio would fight that. min-height: 0 is
       what lets the row shrink to its track — without it the image keeps a
       content-based automatic minimum and overflows the card, which is the
       same trap the footer wordmark hit. */
    .card--wide img {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }
  }

  /* --- Noticias ----------------------------------------------------------
     The home now alternates paper / dark the way the global site alternates
     red / black: work on paper, clients on --color-dark, awards on paper,
     news here. Without it the page ran paper from The Work to the footer and
     the rhythm flattened out over three sections.

     --color-dark-alt and not --color-dark: the footer that follows is
     --color-dark, and two identical darks in a row read as one band with a
     gap in it. One step of value keeps them apart.

     NewsCard reads --card-* if they are set, so the cards follow the band
     without the component needing to know which page it is on. Custom
     properties inherit across component scoping; class names do not. */
  .news {
    background: var(--color-dark-alt);
    color: var(--color-on-dark);
    --card-muted: rgba(250, 250, 250, 0.62);
    --card-line: rgba(250, 250, 250, 0.18);
  }

  /* Only the grid stays here. Everything a card looks like moved into
     NewsCard.astro, which the index page uses too — the card had been written
     twice otherwise, and the two would have drifted. */
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-xl) var(--space-m);
  }
</style>
