---
/**
 * /legal/[slug] — the four notices, embedded from Omnicom's OneTrust tenant.
 *
 * The page ships the title, the chrome and an empty container; OneTrust fills
 * it at runtime. That is how bbdomexico.com does it today and it is the point
 * of the OMC directive: group legal edits the notice once and every agency
 * site shows the new version without anybody redeploying.
 *
 * THE COST, STATED PLAINLY
 *   This is the only third-party script on the site, and it is on the pages
 *   where a visitor is least likely to expect one. Loading the privacy notice
 *   contacts OneTrust, which records a view — the privacy page is the page
 *   that phones home. It also pulls a webfont from gstatic.
 *
 *   And with JavaScript off, the notice does not render at all. A legally
 *   required notice that only exists when a script runs is a weak way to make
 *   it available, so there is a <noscript> route to the same document. That
 *   limitation belongs to the mechanism Omnicom chose; it is written down here
 *   rather than hidden.
 *
 * See src/legal.ts for what is wrong with the notices themselves.
 */
import Base from '../../layouts/Base.astro';
import { NOTICES, noticeSource } from '../../legal';

export function getStaticPaths() {
  return NOTICES.map((notice) => ({ params: { slug: notice.slug }, props: { notice } }));
}

const { notice } = Astro.props;
const containerId = `otnotice-${notice.noticeId}`;

/**
 * `settings` is not a <script> attribute TypeScript knows about, and written
 * inline it made `astro check` fail. It cannot be dropped either: OneTrust
 * reads it off its own tag. Spreading it in is what makes the types accept it
 * without giving the attribute up.
 *
 * The value is base64 of {"callbackUrl":"…/privacyNotices/stats/views"},
 * copied from the current site: it is what makes the notice report the view
 * back to Omnicom.
 */
const oneTrustSettings = {
  settings:
    'eyJjYWxsYmFja1VybCI6Imh0dHBzOi8vb21uaWNvbS1wcml2YWN5Lm15Lm9uZXRydXN0LmNvbS9yZXF1ZXN0L3YxL3ByaXZhY3lOb3RpY2VzL3N0YXRzL3ZpZXdzIn0=',
};
---

<Base
  title={notice.title}
  path={`/legal/${notice.slug}/`}
  description={`${notice.title} de BBDO México, parte de Omnicom Advertising Group.`}
>
  <main id="content">
    <div class="section-shell section-shell--head">
      <p class="kicker">Legal</p>
      <h1 class="title">{notice.title}</h1>
      <p class="intro">{notice.intro}</p>
    </div>

    <div class="section-shell" data-notice data-notice-src={noticeSource(notice.noticeId)}>
      {/* OneTrust requires this exact id and class. Do not rename. */}
      <div id={containerId} class="otnotice"></div>

      {
        /* The wait is real and it is long: six round trips to OneTrust before
           a word appears, 2.3s on a wired connection here and several seconds
           on Mexican 4G. Until now that was a blank page under a heading.

           A skeleton and not a spinner, because the thing being waited for is
           a long text document: bars in the shape of a heading and paragraphs
           say what is coming, where a spinner only says wait.

           It is drawn ONLY under html.js, the same rule ScrollFX follows. With
           JavaScript off nothing here will ever resolve, and a skeleton that
           never finishes is worse than the <noscript> note below, which is the
           real answer for that visitor. */
      }
      <div class="skeleton" data-notice-skeleton aria-hidden="true">
        <span class="skeleton__bar skeleton__bar--title"></span>
        <span class="skeleton__bar"></span>
        <span class="skeleton__bar"></span>
        <span class="skeleton__bar skeleton__bar--short"></span>
        <span class="skeleton__bar skeleton__bar--gap"></span>
        <span class="skeleton__bar"></span>
        <span class="skeleton__bar skeleton__bar--short"></span>
      </div>

      {
        /* Politely announced rather than silent: a screen reader otherwise sits
          on a heading with nothing under it and no reason given. */
      }
      <p class="sr-only" data-notice-status role="status">Cargando el aviso…</p>

      <p class="nojs" data-notice-fallback hidden>
        No hemos podido cargar el aviso. Lo publica Omnicom a través de OneTrust y su servicio no ha
        respondido. Puedes consultarlo directamente en{' '}
        <a href={noticeSource(notice.noticeId)} rel="noopener">el documento original</a>{' '}
        o escribirnos y te lo enviamos.
      </p>

      <noscript>
        <p class="nojs">
          Este aviso lo publica Omnicom a través de OneTrust y necesita JavaScript para mostrarse.
          Puedes consultarlo directamente en{' '}
          <a href={noticeSource(notice.noticeId)} rel="noopener">el documento original</a>{' '}
          o escribirnos y te lo enviamos.
        </p>
      </noscript>
    </div>
  </main>

  {
    /*
    Written with literal attributes on purpose. With `is:inline` Astro drops
    attributes whose values are expressions, and the id vanishing is not a
    cosmetic loss: OneTrust finds its own tag by that id, so without it the
    loader throws on a null getAttribute and no notice ever renders. The same
    values are documented in legal.ts.
  */
  }
  <script
    is:inline
    id="otprivacy-notice-script"
    src="https://omnicom-privacy-cdn.my.onetrust.com/privacy-notice-scripts/otnotice-1.0.min.js"
    charset="UTF-8"
    {...oneTrustSettings}></script>
</Base>

<script>
  import { onPage } from '../../lifecycle';

  /**
   * WHY THIS IS NOT `OneTrust.NoticeApi.Initialized.then(...)` INLINE ANY MORE
   *
   * That is what was here, and it worked on a cold load and only there. The
   * loader is a blocking classic script, so on a fresh document it has always
   * run by the time the next inline script does. After a client-side swap
   * ClientRouter re-inserts both, the external one resolves asynchronously,
   * and the bootstrap ran first and threw `OneTrust is not defined` — a real
   * uncaught error, after which LoadNotices was never called.
   *
   * The effect: all four legal pages were BLANK for anyone who arrived through
   * the footer, which is how everybody arrives. Only a direct load or a
   * refresh ever showed the notice. Verified both ways before and after.
   *
   * So nothing here assumes an order. It waits for the API to exist, with a
   * cap, and gives up honestly instead of hanging.
   */
  /** Only the two entry points this page uses; OneTrust ships no types. */
  interface OneTrustApi {
    NoticeApi?: {
      Initialized?: Promise<unknown>;
      LoadNotices?: (urls: string[]) => void;
    };
  }

  const POLL_MS = 100;
  const GIVE_UP_MS = 15000;

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-notice]');
    if (!root) return;

    const src = root.dataset.noticeSrc;
    const box = root.querySelector<HTMLElement>('.otnotice');
    const skeleton = root.querySelector<HTMLElement>('[data-notice-skeleton]');
    const status = root.querySelector<HTMLElement>('[data-notice-status]');
    const fallback = root.querySelector<HTMLElement>('[data-notice-fallback]');
    if (!src || !box) return;

    let done = false;
    let timer = 0;

    const settle = (ok: boolean) => {
      if (done) return;
      done = true;
      clearTimeout(timer);
      observer.disconnect();
      skeleton?.remove();
      if (status) status.textContent = ok ? 'Aviso cargado.' : 'No se pudo cargar el aviso.';
      if (!ok) fallback?.removeAttribute('hidden');
    };

    /* The notice is rendered by a third party, so there is no callback to
       await: the only honest signal that it arrived is the container getting
       children. */
    const observer = new MutationObserver(() => {
      if (box.children.length > 0) settle(true);
    });
    observer.observe(box, { childList: true });
    if (box.children.length > 0) settle(true);

    timer = window.setTimeout(() => settle(false), GIVE_UP_MS);

    const start = Date.now();
    const boot = () => {
      if (done) return;
      const ot = (window as unknown as { OneTrust?: OneTrustApi }).OneTrust;
      if (ot?.NoticeApi?.Initialized) {
        ot.NoticeApi.Initialized.then(() => {
          if (!done) ot.NoticeApi?.LoadNotices?.([src]);
        }).catch(() => settle(false));
        return;
      }
      if (Date.now() - start > GIVE_UP_MS) return;
      window.setTimeout(boot, POLL_MS);
    };
    boot();

    return () => {
      clearTimeout(timer);
      observer.disconnect();
      done = true;
    };
  });
</script>

<style>
  .kicker {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
    /* Same reason as .award__year: 12.8px is normal text and the brand red does
       not reach 4.5:1 on the paper. */
    color: var(--color-red-deep);
    margin: 0 0 var(--space-xs);
  }
  .title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    text-transform: uppercase;
    font-size: clamp(2rem, 7vw, 4rem);
    line-height: var(--lh-display);
    margin: 0;
  }
  .intro {
    margin: var(--space-m) 0 0;
    color: var(--color-dim);
    max-width: 52ch;
  }

  /* OneTrust ships its own stylesheet and its own class names. These only set
     the measure and let its type inherit the site's, so a legal document does
     not arrive looking like a different website. */
  .otnotice {
    max-width: 78ch;
  }
  .otnotice :global(.otnotice-content) {
    font-family: var(--font-ui);
  }

  /* --- Waiting for OneTrust ---------------------------------------------
     Drawn only when JavaScript is running. Without it nothing will ever
     replace these bars, and the <noscript> note is the real answer. */
  .skeleton {
    display: none;
  }
  :global(html.js) .skeleton {
    display: grid;
    gap: var(--space-s);
    max-width: 78ch;
    margin-top: var(--space-s);
  }
  .skeleton__bar {
    display: block;
    height: 1rem;
    border-radius: 3px;
    /* Same tint the no-JS note uses, so the page has one grey and not two. */
    background: color-mix(in srgb, var(--color-fg) 9%, transparent);
  }
  .skeleton__bar--title {
    height: 2rem;
    width: 55%;
    margin-bottom: var(--space-xs);
  }
  .skeleton__bar--short {
    width: 68%;
  }
  .skeleton__bar--gap {
    margin-top: var(--space-m);
  }

  /* The sweep is the only thing that says this is loading rather than broken.
     It travels across the whole block, so the bars read as one surface. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .skeleton {
      --sweep: color-mix(in srgb, var(--color-fg) 4%, transparent);
      background-image: linear-gradient(100deg, transparent 20%, var(--sweep) 50%, transparent 80%);
      background-size: 220% 100%;
      background-repeat: no-repeat;
      animation: noticeSweep 1.6s linear infinite;
    }
    @keyframes noticeSweep {
      from {
        background-position: 120% 0;
      }
      to {
        background-position: -120% 0;
      }
    }
  }

  .nojs {
    max-width: 60ch;
    padding: var(--space-m);
    border-left: 3px solid var(--color-red);
    background: color-mix(in srgb, var(--color-fg) 5%, transparent);
  }
</style>
