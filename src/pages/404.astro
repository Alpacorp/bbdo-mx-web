---
/**
 * 404 — the site's own dead end, with the design and with exits.
 *
 * The body lives in NotFound.astro because the [...legacy] catch-all renders
 * the same thing with a different status: the pages the current site publishes
 * and this one drops answer 410, not 404.
 */
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound.astro';
---

<Base
  title="Página no encontrada"
  path="/404/"
  description="La página que buscas no existe o cambió de dirección."
>
  <NotFound />
</Base>
