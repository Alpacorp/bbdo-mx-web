---
import { SITE_URL } from '../../organization';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ScrollFX from '../../components/ScrollFX.astro';
import VideoBanner from '../../components/VideoBanner.astro';
import CaseBlock from '../../components/CaseBlock.astro';
import Collage from '../../components/Collage.astro';
import { themeStyle } from '../../themes';

/**
 * /the-work/[slug] — the individual case study. THE SEO asset of the project.
 *
 * Structure taken from the global site's case page (bbdo.com/work/whiskas/):
 *   h1 = campaign name  (the current site prints <h1>Portfolio</h1> on all 19
 *                        cases, which is the defect being fixed)
 *   brand above it, as a kicker
 *   h2 = the result, in figures
 *   body copy + "More work" at the end
 */
export async function getStaticPaths() {
  const cases = await getCollection('work', ({ data }) => !data.draft);
  const sorted = cases.sort((a, b) => a.data.order - b.data.order);

  return sorted.map((caseEntry, i) => ({
    params: { slug: caseEntry.id },
    props: {
      case: caseEntry,
      // the next three, wrapping around: never fewer than three
      related: [1, 2, 3].map((n) => sorted[(i + n) % sorted.length]),
    },
  }));
}

const { case: caseEntry, related } = Astro.props;
const { data } = caseEntry;
const { Content } = await render(caseEntry);

/**
 * The case theme. Custom properties are injected on <main> itself, so
 * everything inside — blocks included — inherits them without touching their
 * own styles. The palettes and their contrast validation live in src/themes.ts.
 */
const themeVars = themeStyle(data.theme);

const url = `${SITE_URL}/the-work/${caseEntry.id}/`;

/**
 * Per-case JSON-LD, the CreativeWork template from jsonld-bbdo-mexico.html.
 * Fields without real data are omitted rather than filled in: an invented
 * `datePublished` is worse than none at all.
 */
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${url}#case`,
  name: data.campaign,
  headline: data.campaign,
  url,
  inLanguage: 'es-MX',
  creator: { '@id': `${SITE_URL}/#organization` },
  sponsor: { '@type': 'Organization', name: data.client },
  about: { '@type': 'Brand', name: data.brand },
  image: new URL(data.image.src, SITE_URL).href,
};
if (data.summary) jsonLd.description = data.summary;
if (data.year) jsonLd.datePublished = String(data.year);
if (data.awards.length) jsonLd.award = data.awards;
---

<Base
  title={`${data.campaign} — ${data.brand}`}
  path={`/the-work/${caseEntry.id}/`}
  overMedia
  description={data.summary || `${data.campaign}, campaña de BBDO México para ${data.brand}.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </Fragment>

  {
    /* The global site uses the SAME masked banner from its home page on case
      pages. We reuse the component, but with the case's own key visual as the
      poster: each campaign opens with its own image, not a generic one.

      The video is still the shared one. MX campaign videos live on Vimeo (the
      id is in `vimeo`), and a Vimeo embed cannot act as a looping background:
      that would need a silent mp4 per campaign. */
  }
  <VideoBanner left="Do" right="Things" src="/v/banner-home.mp4" poster={data.image.src} />

  <main id="content" class="case" style={themeVars} data-theme={data.theme}>
    <nav class="breadcrumb" aria-label="Ruta">
      <a href="/the-work/">The Work</a>
      <span aria-hidden="true">/</span>
      <span>{data.brand}</span>
    </nav>

    <header class="case__header">
      <p class="case__brand" data-fx="up">{data.brand}</p>
      {
        /* The headline reveals line by line, each behind its own mask. The
          same gesture as the home page headline, scaled down. */
      }
      <h1 class="case__title" data-fx="lines"><span>{data.campaign}</span></h1>
      {
        data.result && (
          <h2 class="case__result" data-fx="up" data-fx-delay="0.15">
            {data.result}
          </h2>
        )
      }
      {
        data.summary && (
          <p class="case__summary" data-fx="up" data-fx-delay="0.25">
            {data.summary}
          </p>
        )
      }
    </header>

    {/* The key visual, with parallax inside a frame that crops the overflow. */}
    <figure class="case__frame" data-fx="scale">
      <Image
        src={data.image}
        alt={data.imageAlt}
        widths={[600, 1200, 1800]}
        sizes="(max-width: 60rem) 100vw, 1200px"
        loading="eager"
        class="case__visual"
        data-fx="parallax"
      />
    </figure>

    <section class="description" aria-labelledby="desc-titulo">
      <h2 id="desc-titulo" class="description__title" data-fx="up">La campaña</h2>

      {
        data.description && (
          <p class="description__lead" data-fx="up" data-fx-delay="80">
            {data.description}
          </p>
        )
      }

      <div class="case__body" data-fx="up" data-fx-delay="140">
        <Content />
      </div>

      {
        data.credits.length > 0 && (
          <ul class="credits" data-fx-stagger>
            {data.credits.map((c) => (
              <li>
                <span class="credits__role">{c.role}</span>
                <span class="credits__name">{c.name}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      data.collage && (
        <Collage
          title={data.collage.title}
          images={data.collage.images}
          alt={data.collage.alt}
          caption={data.collage.caption}
        />
      )
    }

    {
      /* Flexible blocks: image strips, quotes, figures, text and video. They
        alternate the entrance side, like the global site. */
    }
    {
      data.blocks.map((block, i) => (
        <CaseBlock block={block} side={i % 2 === 0 ? 'left' : 'right'} />
      ))
    }

    <dl class="facts" data-fx-stagger>
      <div><dt>Cliente</dt><dd>{data.client}</dd></div>
      <div><dt>Marca</dt><dd>{data.brand}</dd></div>
      {
        data.year && (
          <div>
            <>
              <dt>Año</dt>
              <dd>{data.year}</dd>
            </>
          </div>
        )
      }
      {
        data.industry && (
          <div>
            <>
              <dt>Industria</dt>
              <dd>{data.industry}</dd>
            </>
          </div>
        )
      }
      {
        data.capabilities.length > 0 && (
          <div>
            <>
              <dt>Capacidades</dt>
              <dd>{data.capabilities.join(', ')}</dd>
            </>
          </div>
        )
      }
      {
        data.awards.length > 0 && (
          <div>
            <>
              <dt>Premios</dt>
              <dd>{data.awards.join(' · ')}</dd>
            </>
          </div>
        )
      }
    </dl>

    <section class="more" aria-labelledby="mas-titulo">
      <h2 id="mas-titulo" data-fx="up">Más The Work</h2>
      <ul class="more__list">
        {
          related.map((otro, i) => (
            <li data-fx={i % 2 === 0 ? 'left' : 'right'} data-fx-scrub>
              <a href={`/the-work/${otro.id}/`}>
                <Image
                  src={otro.data.image}
                  alt={otro.data.imageAlt}
                  widths={[400, 800]}
                  sizes="(max-width: 40rem) 100vw, 33vw"
                  loading="lazy"
                />
                <h3>{otro.data.brand}</h3>
                <p>{otro.data.campaign}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <ScrollFX />
  </main>
</Base>

<style>
  .case {
    /* Above the sticky banner: this is what makes the content scroll over it
       instead of letting it show through. */
    position: relative;
    z-index: 1;
    /* Reapplying `color` here is essential: body already resolved
       `color: var(--color-fg)` to a concrete value and descendants inherit THAT
       value, not the variable. Redefining --color-fg in the theme was not
       enough on its own. */
    color: var(--color-fg);
    padding-inline: var(--gutter);
    padding-block: var(--space-xl);
    max-width: var(--max-width);
    margin-inline: auto;
  }

  /* The background lives on a full-width pseudo-element and not on .case:
     .case is capped by max-width and its background let the banner show at the
     sides. */
  .case::before {
    content: '';
    position: absolute;
    inset: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: var(--case-background, var(--color-paper));
    z-index: -1;
  }

  .breadcrumb {
    display: flex;
    gap: var(--space-xs);
    font-size: 0.9rem;
    color: var(--color-dim);
    margin-bottom: var(--space-l);
  }
  .breadcrumb a {
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .case__header {
    margin-bottom: var(--space-l);
  }
  .case__brand {
    /* Tried as sticky to anchor the brand during reading, then dropped: once
       unstuck it overlapped the result and the summary. A kicker that stays
       put reads better than one floating over the text. */
    margin: 0 0 var(--space-2xs);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dim);
  }
  .case__title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2.2rem, 7vw, 5rem);
    line-height: var(--lh-display);
    text-transform: uppercase;
    margin: 0;
    max-width: 20ch;
  }
  .case__result {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 3vw, 2.2rem);
    line-height: 1.15;
    color: var(--color-accent);
    margin: var(--space-m) 0 0;
    max-width: 24ch;
  }
  .case__summary {
    margin: var(--space-m) 0 0;
    max-width: 52ch;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.5;
  }

  /* The frame crops; the image inside is taller than the frame so the parallax
     has travel without exposing the background. */
  .case__frame {
    margin: 0 0 var(--space-l);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-dark);
    aspect-ratio: 16 / 9;
  }
  .case__visual {
    width: 100%;
    height: 118%;
    margin-top: -9%;
    object-fit: cover;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    /* Without parallax the overflow is unnecessary, and the framing stays intact. */
    .case__visual {
      height: 100%;
      margin-top: 0;
    }
  }
  @media (max-width: 48rem) {
    /* Parallax is off on mobile, so no overflow is needed here either. */
    .case__visual {
      height: 100%;
      margin-top: 0;
    }
  }

  .case__body {
    max-width: var(--measure);
    line-height: 1.6;
  }
  .case__body :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    text-transform: uppercase;
    margin-top: var(--space-l);
  }

  /* --- Campaign description ------------------------------------------------ */
  .description {
    margin-top: var(--space-xl);
  }
  .description__title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-line);
  }
  .description__lead {
    max-width: var(--measure);
    margin: 0 0 var(--space-m);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.45;
  }

  .credits {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-m);
  }
  .credits li {
    display: grid;
    gap: 2px;
  }
  .credits__role {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .facts {
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
  }
  .facts div {
    display: grid;
    gap: 2px;
  }
  .facts dt {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dim);
  }
  .facts dd {
    margin: 0;
  }

  .more {
    margin-top: var(--space-2xl);
  }
  .more h2 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: var(--space-s);
    margin: 0 0 var(--space-l);
  }
  .more__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l) var(--space-m);
  }
  .more__list a {
    text-decoration: none;
    display: block;
  }
  .more__list img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-dark);
  }
  .more__list h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    margin: var(--space-s) 0 2px;
  }
  .more__list p {
    margin: 0;
    color: var(--color-dim);
    font-size: 0.9rem;
  }
  .more__list a:hover h3 {
    color: var(--color-accent);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(3, 1fr);
    }
    .more__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-height: 32rem) {
    .case {
      padding-block: var(--space-l);
    }
  }
</style>
