---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ScrollFX from '../../components/ScrollFX.astro';

/**
 * /the-work/ — case index.
 *
 * The URL is /the-work/ and not /work/ per client confirmation: it is the name
 * BBDO México uses, and it matches today's /portfolio-page/the-work/. The
 * collection and the assets folder are still called `work` on purpose: those
 * are internal names and renaming them buys nothing.
 *
 * Structure from the global site: an h1 "Work" and a grid of cards with brand
 * (h2) and campaign (h3). Their index has NO filters, even though section 4 of
 * the brief proposes them (brand / industry / capability / year).
 *
 * They are not built yet, and not out of laziness: there is no data behind
 * them. All 19 cases on the current site share a category (Branding) and a
 * date (10 Feb 2024, the bulk upload). A filter with a single value is noise.
 * Once curation fills in industry, capabilities and year, the collection
 * already has the fields and the filter is an afternoon's work.
 */
const cases = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="The Work"
  path="/the-work/"
  description="El trabajo de BBDO México: campañas para Pepsi, Uber, Bayer, Pedigree, EA Sports, Tostitos y más."
>
  <main id="content" class="pagina">
    <header class="page-header">
      <h1 class="page-title" data-fx="lines"><span>The Work</span></h1>
      <p class="header__note" data-fx="up" data-fx-delay="0.2">{cases.length} cases</p>
    </header>

    <ul class="grid" data-fx-stagger>
      {
        cases.map((caseEntry, i) => (
          <li class="card">
            <a href={`/the-work/${caseEntry.id}/`}>
              <Image
                src={caseEntry.data.image}
                alt={caseEntry.data.imageAlt}
                widths={[400, 800, 1200]}
                sizes="(max-width: 40rem) 100vw, (max-width: 60rem) 50vw, 33vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                class="card__img"
              />
              <h2 class="card__brand">{caseEntry.data.brand}</h2>
              <p class="card__campaign">{caseEntry.data.campaign}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <ScrollFX />
  </main>
</Base>

<style>
  .pagina {
    padding-inline: var(--gutter);
    padding-block: var(--space-2xl);
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .page-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: var(--space-s);
    margin-bottom: var(--space-xl);
  }
  .page-header h1 {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: var(--lh-display);
    text-transform: uppercase;
    margin: 0;
  }
  .header__note {
    margin: 0;
    color: var(--color-dim);
    font-size: 0.95rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l) var(--space-m);
  }

  .card a {
    text-decoration: none;
    display: block;
  }
  .card__img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-dark);
  }
  .card__brand {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--size-case-brand);
    line-height: 1.1;
    margin: var(--space-s) 0 var(--space-2xs);
  }
  .card__campaign {
    margin: 0;
    color: var(--color-dim);
    font-size: 0.95rem;
  }
  .card a:hover .card__brand {
    color: var(--color-accent);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-height: 32rem) {
    .pagina {
      padding-block: var(--space-xl);
    }
  }
</style>
